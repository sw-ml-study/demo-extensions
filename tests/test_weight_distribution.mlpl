include "lib/native3d/camera.mlpl";
include "lib/native3d/geometry.mlpl";
include "demos/model-atlas/model.mlpl";
include "demos/model-atlas/scene.mlpl";
include "demos/weight-distribution/model.mlpl";
include "demos/weight-distribution/scene.mlpl";

@test {name:"Weight distributions bin bounded signed samples",tags:["native3d","weights","histogram"]}
def u:test_weight_histogram() { tile=u:wd_tile([-4,-2,-1,0,0,1,2,4],8,8)?; u:assert_eq(tile.count,8,"sample count")?; u:assert_eq(reduce_add(tile.bin_counts),8,"bins conserve samples")?; u:assert_eq([tile.minimum,tile.maximum],[-4,4],"range retained")?; u:assert_eq(tile.zero_count,2,"zero count") }

@test {name:"Weight explorer fails closed for unsupported shared decoders",tags:["native3d","weights","dtype","adversarial"]}
def u:test_weight_dtype_gate() { u:assert_true(u:wd_dtype_supported("safetensors","I16"),"Safetensors I16")?; u:assert_true(u:wd_dtype_supported("gguf",8),"GGUF Q8_0")?; u:assert_true(1-u:wd_dtype_supported("safetensors","F16"),"Safetensors F16 rejected")?; u:assert_true(u:atlas_text_contains(u:wd_dtype_reason("gguf",2),"DEMO-ML-UTILS"),"GGUF unsupported ownership is visible") }

@test {name:"Weight histogram scene uses stable retained IDs and legends",tags:["native3d","weights","retained"]}
def u:test_weight_scene() { state=u:wd_fixture_state([-2,-1,0,1,2]); scene=u:wd_scene(state)?; u:assert_true(gt(tally(scene.ids),8*12+24),"histogram includes world-space labels")?; u:assert_true(lt(-1,u:atlas_scene_line_index(scene,1000)),"first stable histogram ID")?; help=u:wd_help(state); u:assert_true(u:atlas_text_contains(help,"X=WEIGHT VALUE"),"value axis legend")?; u:assert_true(u:atlas_text_contains(help,"Y=LOG2 SAMPLE COUNT"),"count scale legend") }

@test {name:"Weight explorer exposes loading feedback and world-space legends",tags:["native3d","weights","labels","loading"]}
def u:test_weight_loading_and_legends() { base=u:wd_defaults(["real.gguf"]); loading=u:wd_loading(base); u:assert_eq(loading.mode,"loading","catalog scan has an explicit state")?; u:assert_true(u:atlas_text_contains(u:wd_help(loading),"LOADING"),"loading feedback is visible")?; loading_scene=u:wd_mode_scene(loading)?; u:assert_true(gt(tally(loading_scene.ids),3),"loading scene has a visible asymmetric spinner")?; histogram=u:wd_scene(u:wd_fixture_state([-2,-1,0,1,2]))?; u:assert_true(lt(-1,u:atlas_scene_line_index(histogram,2000)),"numeric count scale is world-space geometry")?; u:assert_true(lt(-1,u:atlas_scene_line_index(histogram,2200)),"negative color swatch has a world-space label")?; u:assert_true(lt(-1,u:atlas_scene_line_index(histogram,2240)),"selected color swatch has a world-space label") }

@test {name:"Weight histogram selection emits a retained-scene patch",tags:["weight-distribution","retained-scene"]}
def u:test_weight_scene_patch() { before=u:wd_fixture_state([-2,-1,0,1,2]); after=u:wd_interaction(before,before.camera,1,before.press_x,before.press_y,0); patch=u:wd_scene_patch(before,after)?; u:assert_eq(shape(patch.ids),[24],"old and new selected bins update only their lines")?; u:assert_eq(shape(patch.remove_ids),[0],"fixed histogram topology removes no lines") }

@test {name:"Fail-closed model errors render an unmistakable red 3D X",tags:["native3d","weights","error"]}
def u:test_weight_error_scene() { base=u:wd_defaults(["blocked.gguf"]); state=u:wd_restate(base,"error",0,0,base.tile,8,0,base.camera,"CATALOG REJECTED"); scene=u:wd_mode_scene(state)?; u:assert_eq(tally(scene.ids),3,"error glyph has three strokes")?; u:assert_eq(take(scene.colors,0,0),[1,0.15,0.1,1],"error glyph is red")?; u:assert_true(u:atlas_text_contains(u:wd_help(state),"NO UNSUPPORTED PAYLOAD WAS READ"),"error help explains fail closed") }

@test {name:"Weight interaction failures retain a recoverable error state",tags:["native3d","weights","error","interaction"]}
def u:test_weight_event_error() { state=u:wd_fixture_state([-1,0,1]); failed=u:wd_event_result(state,err("synthetic click failure")); u:assert_eq(failed.mode,"error","handler error becomes state instead of escaping run loop")?; u:assert_true(u:atlas_text_contains(failed.error,"WINDOW RETAINED"),"status explains retained window")?; u:assert_true(u:atlas_text_contains(failed.error,"synthetic click failure"),"original error remains visible")?; help=u:wd_help(failed); u:assert_true(u:atlas_text_contains(help,"R RESTART"),"error offers restart")?; u:assert_true(u:atlas_text_contains(help,"M MODEL MENU"),"error offers model menu")?; u:assert_true(u:atlas_text_contains(help,"ESC QUIT"),"error offers explicit quit") }

u:run_registered_tests()
