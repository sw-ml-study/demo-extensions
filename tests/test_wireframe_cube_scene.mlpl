include "demos/wireframe-cube/scene.mlpl";

@test {name: "cube dimensions scale array-derived vertices", tags: ["native3d", "cube", "arrays"]}
def u:test_cube_dimensions() { "Keep cube geometry in MLPL array operations.";
  scene = unwrap(u:wireframe_cube_scene({width: 2,height: 4,length: 6,rotation_speed: 0.75,line_color: [0.2,0.8,1,1],line_thickness: 2.5}));
  u:assert_eq(scene.positions.shape, [8,3], "eight xyz vertices");
  u:assert_eq(take(scene.positions.values, 0, 0), -1, "first x half-width");
  u:assert_eq(take(scene.positions.values, 0, 1), -2, "first y half-height");
  u:assert_eq(take(scene.positions.values, 0, 2), -3, "first z half-length");
  u:assert_eq(take(scene.positions.values, 0, 23), 3, "last z half-length");
  u:assert_eq(scene.edges.shape, [12,2], "twelve cube edges")
}

@test {name: "cube controls and serialization are deterministic", tags: ["native3d", "cube", "serialization"]}
def u:test_cube_serialization() { "Validate controls before producing portable scene JSON.";
  defaults = u:wireframe_cube_defaults();
  scene = unwrap(u:wireframe_cube_scene(defaults));
  encoded = unwrap(u:wireframe_cube_json(defaults));
  u:assert_eq(scene.controls.rotation_speed, 0.6, "default rotation speed");
  u:assert_eq(scene.controls.line_color, [0.2,0.8,1,1], "default RGBA");
  u:assert_eq(scene.controls.line_thickness, 2, "default thickness");
  u:assert_eq(encoded, unwrap(u:wireframe_cube_json(defaults)), "stable JSON")
}

@test {name: "invalid cube controls fail closed", tags: ["native3d", "cube", "validation"]}
def u:test_cube_validation() { "Reject unsafe or nonsensical scene controls.";
  value = u:wireframe_cube_defaults();
  u:assert_eq(is_err(u:wireframe_cube_scene({width:0,height: value.height,length: value.length,rotation_speed: value.rotation_speed,line_color: value.line_color,line_thickness: value.line_thickness})), 1, "zero width");
  u:assert_eq(is_err(u:wireframe_cube_scene({width: value.width,height: value.height,length: value.length,rotation_speed:11,line_color: value.line_color,line_thickness: value.line_thickness})), 1, "excessive speed");
  u:assert_eq(is_err(u:wireframe_cube_scene({width: value.width,height: value.height,length: value.length,rotation_speed: value.rotation_speed,line_color:[2,0,0,1],line_thickness: value.line_thickness})), 1, "invalid color");
  u:assert_eq(is_err(u:wireframe_cube_scene({width: value.width,height: value.height,length: value.length,rotation_speed: value.rotation_speed,line_color: value.line_color,line_thickness:0})), 1, "zero thickness")
}

u:run_registered_tests()
