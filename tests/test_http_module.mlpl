# Native mlplunit coverage for the public HTTP extension facade.
include "extensions/http-client/module.mlpl";

@test {name: "HTTP demo selects explicit and default URLs", tags: ["extensions", "http"]}
def u:test_http_default_url() {
  "Keep remote endpoint selection deterministic without performing network I/O.";
  u:assert_eq(u:http_default_url(["http://127.0.0.1:8080/time"]),"http://127.0.0.1:8080/time","explicit endpoint wins")?;
  u:assert_eq(u:http_default_url(args()),"https://time.gov/","empty arguments select official example")
}

@test {name: "HTTP download facade builds the exact V1 record", tags: ["extensions", "http"]}
def u:test_http_download_request() {
  "Pin the download record shape without performing any transfer.";
  u:assert_eq(u:http_download_request("https://example.test/model.bin",1024,"ab",  "/srv/models","vendor/model.bin",1048576,600000),{url: "https://example.test/model.bin",expected_bytes: 1024,sha256: "ab",root: "/srv/models",path: "vendor/model.bin",chunk_bytes: 1048576,timeout_ms: 600000},"download record carries exactly the V1 fields")
}

u:run_registered_tests()
