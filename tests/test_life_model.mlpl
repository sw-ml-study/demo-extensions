include "demos/life-plane/model.mlpl";

@test {name:"Life validates finite grids and owns updates",tags:["native3d","life","model"]}
def u:test_life_grid_contract() {
  grid=unwrap(u:life_empty(5,6));
  u:assert_eq([grid.rows,grid.columns,reduce(:add,grid.cells)],[5,6,0],"empty finite grid")?;
  changed=unwrap(u:life_set(grid,2,3,1));
  u:assert_eq(u:life_cell(changed,2,3),1,"set writes an owned replacement")?;
  u:assert_eq(u:life_cell(grid,2,3),0,"source grid remains unchanged")?;
  u:assert_eq(u:life_cell(changed,-1,3),0,"outside finite grid is dead")?;
  u:assert_true(is_err(u:life_empty(0,6)),"zero dimensions are rejected")?;
  u:assert_true(is_err(u:life_set(grid,5,0,1)),"outside writes are rejected")?;
  u:assert_true(is_err(u:life_set(grid,0,0,2)),"cells are binary")
}

@test {name:"Life still lifes and oscillators evolve deterministically",tags:["native3d","life","evolution"]}
def u:test_life_evolution() {
  block=unwrap(u:life_preset("block",8,8,0));
  u:assert_eq(unwrap(u:life_step(block)),block,"block is stable")?;
  blinker=unwrap(u:life_preset("blinker",9,9,0)); one=unwrap(u:life_step(blinker)); two=unwrap(u:life_step(one));
  u:assert_eq(two,blinker,"blinker has period two")?;
  u:assert_eq(reduce(:add,one.cells),3,"blinker population stays three")
}

@test {name:"Life glider moves and large presets enforce bounds",tags:["native3d","life","presets"]}
def u:test_life_moving_presets() {
  glider=unwrap(u:life_preset("glider",12,12,0)); moved=glider; count=0; while lt(count,4) { moved=unwrap(u:life_step(moved)); count=count+1 };
  u:assert_eq(moved.cells,u:life_translate_cells(glider,1,1),"glider moves one diagonal cell in four steps")?;
  gun=unwrap(u:life_preset("glider-gun",20,40,0));
  u:assert_eq(reduce(:add,gun.cells),36,"Gosper gun has 36 live cells")?;
  u:assert_true(is_err(u:life_preset("glider-gun",10,20,0)),"undersized gun grid is rejected")
}

@test {name:"Life presets replace grids and seeded random is repeatable",tags:["native3d","life","presets","random"]}
def u:test_life_preset_replacement() {
  empty=unwrap(u:life_preset("empty",10,10,7)); still=unwrap(u:life_preset("beehive",10,10,7)); spinner=unwrap(u:life_preset("toad",10,10,7));
  a=unwrap(u:life_preset("random",10,10,77)); b=unwrap(u:life_preset("random",10,10,77)); c=unwrap(u:life_preset("random",10,10,78));
  u:assert_eq(reduce(:add,empty.cells),0,"empty clears the whole grid")?;
  u:assert_eq(reduce(:add,still.cells),6,"beehive still life is available")?;
  u:assert_eq(reduce(:add,spinner.cells),6,"toad oscillator is available")?;
  u:assert_eq(a,b,"same random seed is repeatable")?;
  u:assert_true(1-equal(a,c),"different seeds change random replacement")?;
  u:assert_true(is_err(u:life_preset("unknown",10,10,0)),"unknown preset is rejected")
}

u:run_registered_tests()
