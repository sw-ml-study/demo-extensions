# Native mlplunit coverage for the standard TodoMVC domain behavior.
include "lib/web/encoding.mlpl";
include "lib/web/router.mlpl";
include "lib/web/http.mlpl";
include "demos/todomvc/model.mlpl";
include "demos/todomvc/view.mlpl";
include "demos/todomvc/app.mlpl";

@test {name: "TodoMVC supports add edit toggle delete and filters",tags: ["web","todomvc","crud"]}
def u:test_todomvc_crud() {
  "Exercise the standard deterministic TodoMVC state transitions.";
  state=u:todo_empty();
  state=u:todo_add(state,"Learn MLPL")?;
  state=u:todo_add(state,"Build the demo")?;
  first=take(state.ids,0,0);
  second=take(state.ids,0,1);
  state=u:todo_toggle(state,first)?;
  u:assert_eq(u:todo_remaining(state),1,"one active todo remains")?;
  u:assert_eq(u:todo_visible(state,"completed"),[1,0,0,0,0,0,0,0],"completed filter")?;
  state=u:todo_edit(state,second,"Ship TodoMVC")?;
  u:assert_eq(state.titles.item_1,"Ship TodoMVC","edit replaces title")?;
  state=u:todo_delete(state,first)?;
  u:assert_eq(u:todo_visible(state,"all"),[0,1,0,0,0,0,0,0],"delete removes one todo")?;
  state=u:todo_toggle(state,second)?;
  state=u:todo_clear_completed(state);
  u:assert_eq(reduce(:add,state.alive),0,"clear completed removes completed todos")
}

@test {name: "TodoMVC renders escaped HTML and parameterized persistence plans",tags: ["web","todomvc","html","sqlite"]}
def u:test_todomvc_render_and_sql() {
  "Keep user text escaped and SQL values outside statement text.";
  state=u:todo_add(u:todo_empty(),"<script>alert(1)</script>")?;
  html=u:todo_render(state,"all")?;
  u:assert_true(eq(str_find(html,"<script>"),-1),"raw script tag is absent")?;
  u:assert_true(1-eq(str_find(html,"&lt;script&gt;"),-1),"escaped title is visible")?;
  u:assert_true(1-eq(str_find(html,"action=\"/todos\""),-1),"add form is visible")?;
  u:assert_true(1-eq(str_find(html,"action=\"/todos/1/toggle\""),-1),"toggle control is visible")?;
  u:assert_true(1-eq(str_find(html,"action=\"/todos/1/edit\""),-1),"editor is visible")?;
  u:assert_true(1-eq(str_find(html,"action=\"/todos/1/delete\""),-1),"delete control is visible")?;
  u:assert_true(1-eq(str_find(html,"<title>sw-MLPL Demo: TodoMVC</title>"),-1),"browser title identifies the demo")?;
  u:assert_true(1-eq(str_find(html,"<h1>sw-MLPL Demo</h1><h2>TodoMVC</h2>"),-1),"page headings identify the demo")?;
  u:assert_true(1-eq(str_find(html,"aria-label=\"View demo-extensions on GitHub\""),-1),"repository corner is accessible")?;
  u:assert_true(1-eq(str_find(html,"https://github.com/sw-ml-study/demo-extensions"),-1),"repository corner uses the public URL")?;
  u:assert_true(1-eq(str_find(html,"Copyright &copy; 2026 Michael A Wright"),-1),"copyright is visible")?;
  u:assert_true(1-eq(str_find(html,"href=\"https://github.com/sw-ml-study/demo-extensions/blob/main/LICENSE\""),-1),"license link is visible")?;
  plan=u:todo_insert_plan("buy milk");
  u:assert_eq(plan.params,{count: 1,item_0: "buy milk"},"insert binds title")?;
  u:assert_true(eq(str_find(plan.sql,"buy milk"),-1),"title is absent from SQL text")
}

@test {name: "TodoMVC reconstructs persisted rows with stable IDs",tags: ["web","todomvc","sqlite"]}
def u:test_todomvc_persisted_rows() {
  "Rebuild bounded application state from the SQLite provider row contract.";
  rows={count: 2,columns: {count: 3,item_0: "id",item_1: "title",item_2: "completed"},row_0: {count: 3,item_0: 2,item_1: "older",item_2: 1},row_1: {count: 3,item_0: 7,item_1: "newer",item_2: 0}};
  state=u:todo_from_query(rows)?;
  u:assert_eq(state.ids,[2,7,0,0,0,0,0,0],"database IDs remain stable")?;
  u:assert_eq(state.completed,[1,0,0,0,0,0,0,0],"completion state is restored")?;
  u:assert_eq(state.titles.item_1,"newer","titles are restored")?;
  u:assert_eq(state.next_id,8,"next in-memory ID follows the database maximum")
}

@test {name: "TodoMVC controller routes a form create request",tags: ["web","todomvc","controller"]}
def u:test_todomvc_controller() {
  "Route one native-shaped request through an MLPL-owned TodoMVC controller.";
  request={method: "POST",path: "/todos",query: "",body: tokenize_bytes("title=Write+tests")};
  result=u:todo_dispatch(u:todo_empty(),request)?;
  u:assert_eq(result.state.titles.item_0,"Write tests","form creates todo")?;
  u:assert_eq(result.response.status,200,"controller renders success")?;
  u:assert_eq(result.db_plan.params.item_0,"Write tests","controller emits bound persistence value")
}

@test {name: "web framework builds post-redirect-get responses",tags: ["web","todomvc","http"]}
def u:test_todomvc_redirect() {
  "Keep browser refreshes from resubmitting TodoMVC mutations.";
  response=u:web_redirect_response("/")?;
  u:assert_eq(response.status,303,"mutation redirect status")?;
  u:assert_eq(response.headers.item_0,{name: "location",value: "/"},"redirect location")?;
  u:assert_eq(size_bytes(response.body),0,"redirect has an empty packed body")
}

@test {name: "TodoMVC permits both loopback browser origins",tags: ["web","todomvc","cors"]}
def u:test_todomvc_loopback_origins() {
  "Keep localhost and numeric loopback browser sessions inside the narrow CORS allowlist.";
  policy=u:todo_middleware_policy(3000);
  u:assert_true(1-eq(str_find(policy,"http://127.0.0.1:3000"),-1),"numeric loopback origin is allowed")?;
  u:assert_true(1-eq(str_find(policy,"http://localhost:3000"),-1),"localhost origin is allowed")
}

u:run_registered_tests()
