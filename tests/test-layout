#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

required_files='Cargo.toml
crates/mlpl-extension-abi/Cargo.toml
crates/mlpl-extension-abi/src/lib.rs
crates/mlpl-extension-loader/Cargo.toml
crates/mlpl-extension-loader/src/lib.rs
crates/mlpl-extension-sdk/Cargo.toml
crates/mlpl-extension-sdk/src/lib.rs
crates/mlpl-native3d-scene/Cargo.toml
crates/mlpl-native3d-scene/src/lib.rs
crates/mlpl-native3d-scene/src/renderer.rs
demos/wireframe-cube/scene.mlpl
extensions/hello/Cargo.toml
extensions/hello/extension.toml
extensions/hello/module.mlpl
extensions/hello/src/lib.rs
mlplunit.conf
scripts/check
scripts/check-gitignore
scripts/check-namespaces
scripts/check-tracked
scripts/run-rust-tests
scripts/run-tests
scripts/select-mlpl
scripts/select-mlplunit
tests/test_hello_module.mlpl
tests/test_wireframe_cube_scene.mlpl'

printf '%s\n' "$required_files" | while IFS= read -r path; do
  if [ ! -f "$repo_root/$path" ]; then
    echo "missing required scaffold file: $path" >&2
    exit 1
  fi
done

echo "PASS repository layout"
