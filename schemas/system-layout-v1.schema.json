{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sw-ml-study.github.io/demo-extensions/schemas/system-layout-v1.schema.json",
  "title": "sw-ml-study renderer-neutral system layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "provenance", "spaces", "regions", "relationships"],
  "properties": {
    "schema": { "const": "sw-ml-study.system-layout" },
    "version": { "const": 1 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "spaces": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/space" } },
    "regions": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/region" } },
    "relationships": { "type": "array", "maxItems": 131072, "items": { "$ref": "#/$defs/relationship" } },
    "composition": { "$ref": "#/$defs/composition" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["producer", "producer_revision", "generated_at", "source_description"],
      "properties": {
        "producer": { "$ref": "#/$defs/text" },
        "producer_revision": { "$ref": "#/$defs/text" },
        "generated_at": { "$ref": "#/$defs/text" },
        "source_description": { "$ref": "#/$defs/text" }
      }
    },
    "space": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "address_unit", "extent"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "address_unit": { "$ref": "#/$defs/text" },
        "extent": { "type": "integer", "minimum": 1 },
        "block_size": { "type": "integer", "minimum": 1 },
        "sector_size": { "type": "integer", "minimum": 1 }
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "space_id", "address", "extent", "purpose", "owner", "location", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "space_id": { "$ref": "#/$defs/text" },
        "address": { "type": "integer", "minimum": 0 }, "extent": { "type": "integer", "minimum": 1 },
        "purpose": { "$ref": "#/$defs/text" }, "owner": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" }, "state": { "$ref": "#/$defs/text" }
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from_region_id", "to_region_id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "from_region_id": { "$ref": "#/$defs/text" },
        "to_region_id": { "$ref": "#/$defs/text" }, "kind": { "$ref": "#/$defs/text" }
      }
    },
    "composition": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "image_id", "part_index", "part_count"],
      "properties": {
        "format": { "const": "C24IMG" }, "image_id": { "$ref": "#/$defs/text" },
        "part_index": { "type": "integer", "minimum": 0 }, "part_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
