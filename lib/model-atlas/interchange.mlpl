# Reusable MLPL library primitives for lib model atlas interchange.
include "./bounded_scan.mlpl";

def u:atlas_table_row(table,index) {
  "Provide atlas table row behavior in this MLPL module.";
  take(table,0,index)
}
def u:atlas_text_row(table,lengths,index,width) {
  "Provide atlas text row behavior in this MLPL module.";
  row=u:atlas_table_row(table,index);
  decode_bytes(compress(lt(range(width),take(lengths,0,index)),row))
}
def u:atlas_expected_id(artifact,name) {
  "Provide atlas expected id behavior in this MLPL module.";
  decode_bytes(concat(tokenize_bytes(artifact),concat(tokenize_bytes(":tensor:"),tokenize_bytes(name))))
}

def u:atlas_validate_interchange_budgets(b) {
  "Provide atlas validate interchange budgets behavior in this MLPL module.";
  u:atlas_budget(b.max_objects,5,"Model Atlas object budget")?;
  u:atlas_budget(b.max_tensors,1,"Model Atlas tensor budget")?;
  u:atlas_budget(b.max_label_bytes,1,"Model Atlas label budget")?;
  u:atlas_budget(b.max_id_bytes,1,"Model Atlas ID budget")?;
  u:atlas_budget(b.max_hierarchy_depth,1,"Model Atlas hierarchy budget")?;
  u:atlas_budget(b.max_coordinate,1,"Model Atlas coordinate budget")?;
  u:atlas_budget(b.max_parameters,1,"Model Atlas parameter budget")?;
  u:atlas_budget(b.max_elements,1,"Model Atlas element budget")?;
  u:atlas_budget(b.max_iterations,1,"Model Atlas iteration budget")?;
  u:atlas_budget(b.max_output_bytes,1,"Model Atlas transport byte budget")?;
  u:atlas_budget(b.max_json_depth,1,"Model Atlas JSON depth budget")?;
  u:atlas_budget(b.max_json_elements,1,"Model Atlas JSON element budget")?;
  ok(1)
}

def u:atlas_interchange(city,b) {
  "Provide atlas interchange behavior in this MLPL module.";
  u:atlas_validate_interchange_budgets(b)?;
  expected_root=["provenance","schema","tensor_columns","version"];
  expected_columns=["byte_counts","count","depths","format_codes","group_ids","heights","id_bytes","id_lengths","name_bytes","name_depths","name_lengths","parameters","widths","x","y","z"];
  if 1-equal(record_keys(city),expected_root) {
    err("tensor-city root schema fields mismatch")
  } else {
    if 1-equal(city.schema,"sw-ml-study.tensor-city") {
      err("tensor-city schema mismatch")
    } else {
      if 1-eq(city.version,1) {
        err("tensor-city version mismatch")
      } else {
        if 1-equal(record_keys(city.provenance),["analyzer","sources"]) {
          err("tensor-city provenance fields mismatch")
        } else {
          if 1-equal(record_keys(city.provenance.sources),["gguf","safetensors"]) {
            err("tensor-city provenance sources mismatch")
          } else {
            if 1-equal(record_keys(city.tensor_columns),expected_columns) {
              err("tensor-city column fields mismatch")
            } else {
              safe=city.provenance.sources.safetensors;
              gguf=city.provenance.sources.gguf;
              if (1-equal(safe.format,"safetensors"))+(1-equal(gguf.format,"gguf")) {
                return err("tensor-city provenance formats mismatch")
              };
              c=city.tensor_columns;
              count=c.count;
              if (1-u:atlas_nonnegative_integer(count))+gt(count,b.max_tensors)+gt(count+5,b.max_objects) {
                return err("tensor-city tensor or logical object budget exceeded")
              };
              if gt(count*(b.max_label_bytes+b.max_id_bytes+13),b.max_elements) {
                return err("tensor-city element budget exceeded")
              };
              if (1-equal(shape(c.name_bytes),[count,b.max_label_bytes]))+(1-equal(shape(c.id_bytes),[count,b.max_id_bytes])) {
                return err("tensor-city padded text shape mismatch")
              };
              lengths=[tally(c.name_lengths),tally(c.name_depths),tally(c.id_lengths),tally(c.format_codes),tally(c.group_ids),tally(c.x),tally(c.y),tally(c.z),tally(c.widths),tally(c.depths),tally(c.heights),tally(c.parameters),tally(c.byte_counts)];
              if 1-equal(lengths,fill([13],count)) {
                return err("tensor-city column length mismatch")
              };
              index=0;
              safe_index=0;
              gguf_index=0;
              iterations=0;
              while lt(index,count) {
                name_length=take(c.name_lengths,0,index);
                id_length=take(c.id_lengths,0,index);
                if (1-u:atlas_nonnegative_integer(name_length))+gt(name_length,b.max_label_bytes)+(1-u:atlas_nonnegative_integer(id_length))+gt(id_length,b.max_id_bytes) {
                  return err("tensor-city text length budget exceeded")
                };
                name=u:atlas_text_row(c.name_bytes,c.name_lengths,index,b.max_label_bytes);
                id=u:atlas_text_row(c.id_bytes,c.id_lengths,index,b.max_id_bytes);
                format=take(c.format_codes,0,index);
                group=take(c.group_ids,0,index);
                artifact=if eq(format,0) {
                  safe.artifact_id
                } else {
                  if eq(format,1) {
                    gguf.artifact_id
                  } else {
                    return err("tensor-city format code is invalid")
                  }
                };
                if 1-eq(format,group) {
                  return err("tensor-city format/group mismatch")
                };
                if 1-equal(id,u:atlas_expected_id(artifact,name)) {
                  return err("tensor-city stable ID mismatch")
                };
                local=if eq(group,0) {
                  safe_index
                } else {
                  gguf_index
                };
                expected_x=local*2;
                expected_z=group*4;
                parameters=take(c.parameters,0,index);
                height=take(c.heights,0,index);
                if (1-u:atlas_nonnegative_integer(parameters))+gt(parameters,b.max_parameters)+(1-eq(height,parameters+1))+(1-eq(take(c.y,0,index),height/2))+(1-eq(take(c.x,0,index),expected_x))+(1-eq(take(c.z,0,index),expected_z))+(1-eq(take(c.widths,0,index),1))+(1-eq(take(c.depths,0,index),1)) {
                  return err("tensor-city deterministic layout mismatch")
                };
                if gt(abs(expected_x),b.max_coordinate)+gt(abs(expected_z),b.max_coordinate)+gt(abs(height),b.max_coordinate)+gt(take(c.name_depths,0,index),b.max_hierarchy_depth) {
                  return err("tensor-city coordinate or hierarchy budget exceeded")
                };
                prior=0;
                while lt(prior,index) {
                  prior_id=u:atlas_text_row(c.id_bytes,c.id_lengths,prior,b.max_id_bytes);
                  if equal(prior_id,id) {
                    return err("tensor-city stable ID collision")
                  };
                  prior=prior+1;
                  iterations=iterations+1;
                  if gt(iterations,b.max_iterations) {
                    return err("tensor-city validation iteration budget exceeded")
                  }
                };
                if eq(group,0) {
                  safe_index=safe_index+1
                } else {
                  gguf_index=gguf_index+1
                };
                index=index+1;
                iterations=iterations+1;
                if gt(iterations,b.max_iterations) {
                  return err("tensor-city validation iteration budget exceeded")
                }
              };
              ok({schema: "sw-ml-study.model-atlas.interchange",version: 1,tensor_count: count,logical_objects: count+5,provenance: city.provenance,scene_columns: c,bounds: b})
            }
          }
        }
      }
    }
  }
}

def u:atlas_interchange_transport(city,b) {
  "Provide atlas interchange transport behavior in this MLPL module.";
  validated=u:atlas_interchange(city,b)?;
  json=to_json(city,{tagged: 1})?;
  bytes=tally(tokenize_bytes(json));
  if gt(bytes,b.max_output_bytes) {
    err("Model Atlas transport byte budget exceeded")
  } else {
    decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?;
    u:atlas_interchange(decoded,b)?;
    if 1-equal(decoded,city) {
      err("Model Atlas tagged JSON round trip changed the interchange")
    } else {
      ok({schema: validated.schema,version: validated.version,json: json,utf8_bytes: bytes,decoded: decoded})
    }
  }
}
