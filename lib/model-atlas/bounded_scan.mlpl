# Bounded, renderer-neutral model catalog scanner. Format adapters provide
# validated catalog ranges and tensor descriptors; this layer owns budgets,
# repeated range reads, compact columns, selection reads, and cache accounting.

def u:atlas_nonnegative_integer(value) { eq(value,floor(value))*gt(value,-1) }
def u:atlas_range_inside(offset,length,size) { u:atlas_nonnegative_integer(offset)*u:atlas_nonnegative_integer(length)*lt(offset,size+1)*lt(length,size-offset+1) }
def u:atlas_ranges_overlap(a_offset,a_length,b_offset,b_length) { lt(a_offset,b_offset+b_length)*lt(b_offset,a_offset+a_length) }
def u:atlas_budget(value,minimum,message) { if (1-u:atlas_nonnegative_integer(value))+lt(value,minimum) { err(message) } else { ok(value) } }

def u:atlas_validate_budgets(b) {
  u:atlas_budget(b.max_catalog_bytes,1,"catalog byte budget must be positive")?; u:atlas_budget(b.max_tensors,1,"tensor budget must be positive")?; u:atlas_budget(b.max_rank,1,"rank budget must be positive")?; u:atlas_budget(b.max_name_bytes,1,"name budget must be positive")?; u:atlas_budget(b.max_detail_bytes,1,"detail byte budget must be positive")?; u:atlas_budget(b.max_iterations,1,"iteration budget must be positive")?; u:atlas_budget(b.max_cache_bytes,b.max_detail_bytes,"cache byte budget must hold one detail")?; u:atlas_budget(b.max_cache_entries,1,"cache entry budget must be positive")?; ok(1)
}

def u:atlas_catalog_pass(path,ranges,b) {
  if (1-eq(tally(shape(ranges)),2))+(1-eq(take(shape(ranges),0,1),2)) { return err("catalog ranges must have shape [N,2]") }; flat=flatten(ranges); count=take(shape(ranges),0,0); index=0; total=0; fingerprint=0;
  while lt(index,count) { if gt(index+1,b.max_iterations) { return err("catalog range iteration budget exceeded") }; offset=take(flat,0,index*2); length=take(flat,0,index*2+1); size=file_size(path)?; if (1-u:atlas_range_inside(offset,length,size))+lt(length,1) { return err("catalog range is outside the file or empty") }; prior=0; while lt(prior,index) { if u:atlas_ranges_overlap(offset,length,take(flat,0,prior*2),take(flat,0,prior*2+1)) { return err("catalog ranges overlap") }; prior=prior+1 }; total=total+length; if gt(total,b.max_catalog_bytes) { return err("catalog byte budget exceeded") }; bytes=read_bytes(path,offset,length)?; if 1-eq(tally(bytes),length) { return err("catalog range was truncated") }; fingerprint=fingerprint+reduce(:add,bytes)+offset*131+length*17; index=index+1 };
  ok({bytes: total,fingerprint: fingerprint,iterations: index})
}

def u:atlas_tensor_product(shape,rank,max_rank,max_iterations) { if gt(rank,max_rank) { err("tensor rank budget exceeded") } else { product=1; axis=0; while lt(axis,rank) { dimension=take(shape,0,axis); if (1-u:atlas_nonnegative_integer(dimension))+gt(dimension,9007199254740991) { return err("tensor shape is invalid") }; if gt(product,9007199254740991/(dimension+eq(dimension,0))) { return err("tensor parameter count overflow") }; product=product*dimension; axis=axis+1; if gt(axis,max_iterations) { return err("tensor shape iteration budget exceeded") } }; ok(product) } }

def u:atlas_scan(path,adapter,b) {
  u:atlas_validate_budgets(b)?; actual_size=file_size(path)?; if (1-u:atlas_nonnegative_integer(actual_size))+gt(actual_size,9007199254740991) { return err("model file size exceeds the exact integer domain") };
  if 1-equal(adapter.schema,"sw-ml-study.model-atlas.scan-adapter") { err("scan adapter schema mismatch") } else { if 1-eq(adapter.version,1) { err("scan adapter version mismatch") } else { if (1-equal(adapter.format,"safetensors"))*(1-equal(adapter.format,"gguf")) { err("scan adapter format is unsupported") } else { if 1-eq(adapter.file_size,actual_size) { err("scan adapter file size mismatch") } else {
    first=u:atlas_catalog_pass(path,adapter.catalog_ranges,b)?; second=u:atlas_catalog_pass(path,adapter.catalog_ranges,b)?; if 1-eq(first.fingerprint,second.fingerprint) { return err("catalog changed between deterministic passes") };
    columns=adapter.tensor_columns; count=columns.count; if gt(count,b.max_tensors) { return err("tensor count budget exceeded") }; expected=[count,count,count,count,count]; actual=[tally(columns.offsets),tally(columns.lengths),tally(columns.ranks),tally(columns.dtype_codes),tally(columns.name_lengths)]; if 1-equal(actual,expected) { return err("tensor column lengths mismatch") }; if (1-equal(shape(columns.shapes),[count,b.max_rank]))+(1-equal(shape(columns.name_bytes),[count,b.max_name_bytes])) { return err("tensor padded table shape mismatch") };
    parameters=fill([0],0); index=0; iterations=first.iterations+second.iterations;
    while lt(index,count) { offset=take(columns.offsets,0,index); length=take(columns.lengths,0,index); rank=take(columns.ranks,0,index); name_length=take(columns.name_lengths,0,index); if gt(name_length,b.max_name_bytes) { return err("tensor name byte budget exceeded") }; if 1-u:atlas_range_inside(offset,length,actual_size) { return err("tensor payload range is invalid") }; range_index=0; ranges_flat=flatten(adapter.catalog_ranges); while lt(range_index,take(shape(adapter.catalog_ranges),0,0)) { if u:atlas_ranges_overlap(offset,length,take(ranges_flat,0,range_index*2),take(ranges_flat,0,range_index*2+1)) { return err("tensor payload overlaps catalog bytes") }; range_index=range_index+1 }; other=0; while lt(other,index) { prior_offset=take(columns.offsets,0,other); prior_length=take(columns.lengths,0,other); overlap=u:atlas_ranges_overlap(offset,length,prior_offset,prior_length); if overlap { return err("tensor payload ranges overlap") }; other=other+1; iterations=iterations+1; if gt(iterations,b.max_iterations) { return err("scan iteration budget exceeded") } }; tensor_shape=take(columns.shapes,0,index); product=u:atlas_tensor_product(tensor_shape,rank,b.max_rank,b.max_iterations)?; parameters=concat(parameters,product); index=index+1; iterations=iterations+1; if gt(iterations,b.max_iterations) { return err("scan iteration budget exceeded") } };
    ok({schema: "sw-ml-study.model-atlas.scan",version: 1,format: adapter.format,source: path,file_size: actual_size,tensor_count: count,catalog_bytes: first.bytes,catalog_fingerprints: [first.fingerprint,second.fingerprint],passes: 2,tensor_columns: {offsets: columns.offsets,lengths: columns.lengths,parameters: parameters,ranks: columns.ranks,shapes: columns.shapes,dtype_codes: columns.dtype_codes,name_lengths: columns.name_lengths,name_bytes: columns.name_bytes},bounds: {max_catalog_bytes: b.max_catalog_bytes,max_tensors: b.max_tensors,max_rank: b.max_rank,max_name_bytes: b.max_name_bytes,max_detail_bytes: b.max_detail_bytes,max_iterations: b.max_iterations,max_cache_bytes: b.max_cache_bytes,max_cache_entries: b.max_cache_entries}})
  } } } }
}

def u:atlas_read_detail(path,scan,tensor_id,relative_offset,length,b) {
  u:atlas_validate_budgets(b)?; if 1-equal(scan.schema,"sw-ml-study.model-atlas.scan") { err("detail scan schema mismatch") } else { if (1-u:atlas_nonnegative_integer(tensor_id))+gt(tensor_id,scan.tensor_count-1) { err("detail tensor ID is invalid") } else { if gt(length,b.max_detail_bytes) { err("detail byte budget exceeded") } else { tensor_offset=take(scan.tensor_columns.offsets,0,tensor_id); tensor_length=take(scan.tensor_columns.lengths,0,tensor_id); if 1-u:atlas_range_inside(relative_offset,length,tensor_length) { err("detail range escapes selected tensor") } else { absolute=tensor_offset+relative_offset; bytes=read_bytes(path,absolute,length)?; if 1-eq(tally(bytes),length) { err("detail range was truncated") } else { ok({schema: "sw-ml-study.model-atlas.detail",version: 1,tensor_id: tensor_id,absolute_offset: absolute,length: length,bytes: bytes}) } } } } }
}

def u:atlas_cache_admit(current_bytes,current_entries,detail,b) { if (1-u:atlas_nonnegative_integer(current_bytes))+(1-u:atlas_nonnegative_integer(current_entries))+gt(current_bytes,b.max_cache_bytes-detail.length)+gt(current_entries,b.max_cache_entries-1) { err("detail cache byte or entry budget exceeded") } else { ok({bytes: current_bytes+detail.length,entries: current_entries+1}) } }
