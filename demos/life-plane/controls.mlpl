# MLPL application semantics for demos life plane controls.
include "./model.mlpl";
include "../../lib/native3d/camera.mlpl";

def u:life_help() {
  "MOUSE: CLICK TOGGLE   CTRL+LEFT DRAG PAINT\nLEFT DRAG ORBIT/TILT   SHIFT+LEFT OR MIDDLE DRAG PAN   WHEEL ZOOM\nSPACE RUN/PAUSE   N STEP   C CLEAR   +/- SPEED\nB BLOCK   H BEEHIVE   I BLINKER   T TOAD\nG GLIDER   U GUN   R RANDOM   ESC CLOSE"
}

def u:life_app_state(grid,running,generation,speed,accumulator_ms,camera,viewport_width,viewport_height,hover_cell,revision,close_requested,random_seed,press_x,press_y,gesture_dragged,painting) {
  "Provide life app state behavior in this MLPL module.";
  {grid: grid,running: running,generation: generation,speed: speed,accumulator_ms: accumulator_ms,camera: camera,viewport_width: viewport_width,viewport_height: viewport_height,hover_cell: hover_cell,revision: revision,close_requested: close_requested,random_seed: random_seed,press_x: press_x,press_y: press_y,gesture_dragged: gesture_dragged,painting: painting}
}

def u:life_app_defaults() {
  "Provide life app defaults behavior in this MLPL module.";
  camera=u:n3d_camera_state([0,0,0],0,0.85,12,1.0471975511965976,0.1,0,"none",0,0);
  u:life_app_state(unwrap(u:life_empty(40,40)),0,0,4,0,camera,800,600,-1,0,0,1,0,0,0,0)
}

def u:life_restate(state,grid,running,generation,speed,accumulator_ms,camera,hover_cell,close_requested,random_seed,press_x,press_y,gesture_dragged,painting) {
  "Provide life restate behavior in this MLPL module.";
  visual_changed=(1-equal(grid,state.grid))+(1-equal(camera,state.camera))+(1-eq(hover_cell,state.hover_cell));
  visual_changed=if visual_changed {
    1
  } else {
    0
  };
  u:life_app_state(grid,running,generation,speed,accumulator_ms,camera,state.viewport_width,state.viewport_height,hover_cell,state.revision+visual_changed,close_requested,random_seed,press_x,press_y,gesture_dragged,painting)
}

def u:life_pointer_cell(state,event) {
  "Provide life pointer cell behavior in this MLPL module.";
  ray=u:n3d_pick_ray(state.camera,{viewport:{width: state.viewport_width,height: state.viewport_height},xy:[event.x,event.y]})?;
  hit=u:n3d_ray_plane_hit(ray,[0,0,0],[0,1,0])?;
  if 1-hit.hit {
    ok(-1)
  } else {
    cell_size=0.2;
    x=take(hit.point,0,0);
    z=take(hit.point,0,2);
    column=floor(x/cell_size+state.grid.columns/2);
    row=floor(z/cell_size+state.grid.rows/2);
    if u:life_inside(state.grid,row,column) {
      ok(row*state.grid.columns+column)
    } else {
      ok(-1)
    }
  }
}

def u:life_set_index(state,index,value) {
  "Provide life set index behavior in this MLPL module.";
  if lt(index,0)+gt(index,state.grid.rows*state.grid.columns-1) {
    state
  } else {
    row=floor(index/state.grid.columns);
    column=index-row*state.grid.columns;
    grid=unwrap(u:life_set(state.grid,row,column,value));
    u:life_restate(state,grid,state.running,state.generation,state.speed,state.accumulator_ms,state.camera,index,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting)
  }
}

def u:life_toggle_index(state,index) {
  "Provide life toggle index behavior in this MLPL module.";
  if lt(index,0) {
    state
  } else {
    value=1-take(state.grid.cells,0,index);
    u:life_set_index(state,index,value)
  }
}

def u:life_replace(state,name,seed) {
  "Provide life replace behavior in this MLPL module.";
  grid_result=u:life_preset(name,state.grid.rows,state.grid.columns,seed);
  if is_err(grid_result) {
    state
  } else { u:life_restate(state,unwrap(grid_result),0,0,state.speed,0,state.camera,-1,state.close_requested,seed,state.press_x,state.press_y,0,0) }
}

def u:life_key_reduce(state,key) {
  "Provide life key reduce behavior in this MLPL module.";
  if equal(key,"space") { u:life_restate(state,state.grid,1-state.running,state.generation,state.speed,state.accumulator_ms,state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting) } else {
    if equal(key,"n") { u:life_restate(state,unwrap(u:life_step(state.grid)),state.running,state.generation+1,state.speed,0,state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting) } else {
      if equal(key,"c") { u:life_replace(state,"empty",state.random_seed) } else {
        if equal(key,"b") { u:life_replace(state,"block",state.random_seed) } else {
          if equal(key,"h") { u:life_replace(state,"beehive",state.random_seed) } else {
            if equal(key,"i") { u:life_replace(state,"blinker",state.random_seed) } else {
              if equal(key,"t") { u:life_replace(state,"toad",state.random_seed) } else {
                if equal(key,"g") { u:life_replace(state,"glider",state.random_seed) } else {
                  if equal(key,"u") { u:life_replace(state,"glider-gun",state.random_seed) } else {
                    if equal(key,"r") { u:life_replace(state,"random",state.random_seed+1) } else {
                      if equal(key,"+")+equal(key,"equal") { u:life_restate(state,state.grid,state.running,state.generation,u:n3d_clamp(state.speed+1,1,30),state.accumulator_ms,state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting) } else {
                        if equal(key,"-")+equal(key,"minus") { u:life_restate(state,state.grid,state.running,state.generation,u:n3d_clamp(state.speed-1,1,30),state.accumulator_ms,state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting) } else {
                          state
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

def u:life_frame_reduce(state,event) {
  "Provide life frame reduce behavior in this MLPL module.";
  if (1-state.running)+state.close_requested {
    state
  } else {
    accumulated=state.accumulator_ms+event.delta_ms;
    interval=1000/state.speed;
    if lt(accumulated,interval) { u:life_restate(state,state.grid,state.running,state.generation,state.speed,accumulated,state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting) } else {
      u:life_restate(state,unwrap(u:life_step(state.grid)),state.running,state.generation+1,state.speed,u:n3d_clamp(accumulated-interval,0,interval),state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting)
    }
  }
}

def u:life_reduce(state,event) {
  "Provide life reduce behavior in this MLPL module.";
  if equal(event.kind,"key") { u:life_key_reduce(state,event.key) } else {
    if equal(event.kind,"frame") { u:life_frame_reduce(state,event) } else {
      if equal(event.kind,"pointer_down") {
        if equal(event.button,"left")*event.control {
          cell=unwrap(u:life_pointer_cell(state,event));
          painted=u:life_set_index(state,cell,1);
          u:life_restate(painted,painted.grid,painted.running,painted.generation,painted.speed,painted.accumulator_ms,painted.camera,cell,painted.close_requested,painted.random_seed,event.x,event.y,0,1)
        } else {
          camera=u:n3d_camera_reduce(state.camera,event);
          u:life_restate(state,state.grid,state.running,state.generation,state.speed,state.accumulator_ms,camera,-1,state.close_requested,state.random_seed,event.x,event.y,0,0)
        }
      } else {
        if equal(event.kind,"pointer_move") {
          if state.painting*event.left*event.control {
            cell=unwrap(u:life_pointer_cell(state,event));
            u:life_set_index(state,cell,1)
          } else {
            if state.camera.dragging {
              distance2=(event.x-state.press_x)*(event.x-state.press_x)+(event.y-state.press_y)*(event.y-state.press_y);
              dragged=state.gesture_dragged+gt(distance2,16);
              dragged=if dragged {
                1
              } else {
                0
              };
              camera=if dragged { u:n3d_camera_reduce(state.camera,event) } else {
                state.camera
              };
              u:life_restate(state,state.grid,state.running,state.generation,state.speed,state.accumulator_ms,camera,-1,state.close_requested,state.random_seed,state.press_x,state.press_y,dragged,0)
            } else {
              state
            }
          }
        } else {
          if equal(event.kind,"pointer_up") {
            if state.painting { u:life_restate(state,state.grid,state.running,state.generation,state.speed,state.accumulator_ms,state.camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,0,0) } else {
              camera=u:n3d_camera_reduce(state.camera,event);
              released=u:life_restate(state,state.grid,state.running,state.generation,state.speed,state.accumulator_ms,camera,-1,state.close_requested,state.random_seed,state.press_x,state.press_y,0,0);
              cell=unwrap(u:life_pointer_cell(released,event));
              if equal(event.button,"left")*(1-state.gesture_dragged) { u:life_toggle_index(released,cell) } else {
                released
              }
            }
          } else {
            if equal(event.kind,"wheel") {
              camera=u:n3d_camera_reduce(state.camera,event);
              u:life_restate(state,state.grid,state.running,state.generation,state.speed,state.accumulator_ms,camera,state.hover_cell,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting)
            } else {
              if equal(event.kind,"resize") {
                resized=u:life_app_state(state.grid,state.running,state.generation,state.speed,state.accumulator_ms,state.camera,u:n3d_clamp(event.width,1,8192),u:n3d_clamp(event.height,1,8192),-1,state.revision,state.close_requested,state.random_seed,state.press_x,state.press_y,state.gesture_dragged,state.painting);
                resized
              } else {
                if equal(event.kind,"close") { u:life_restate(state,state.grid,0,state.generation,state.speed,state.accumulator_ms,state.camera,-1,1,state.random_seed,state.press_x,state.press_y,0,0) } else {
                  state
                }
              }
            }
          }
        }
      }
    }
  }
}
