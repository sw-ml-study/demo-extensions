# MLPL application semantics for demos life plane live applet.
include "./scene.mlpl";

def u:life_submit(state) {
  "Provide life submit behavior in this MLPL module.";
  scene=u:life_scene(state)?;
  port_send(port,{op:"set_scene",positions: scene.positions,edges: scene.edges,colors: scene.colors,thicknesses: scene.thicknesses,ids: scene.ids,rotation_y_speed:0,revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:life_help()});
  ok(state)
}

def u:life_submit_view(state) {
  "Provide life submit view behavior in this MLPL module.";
  port_send(port,{op:"set_view",revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:life_help()});
  ok(state)
}

def u:life_submit_patch(before,after) {
  "Provide life submit patch behavior in this MLPL module.";
  port_send(port,u:life_scene_patch(before,after));
  ok(after)
}

def u:life_on_event(event,state) {
  "Provide life on event behavior in this MLPL module.";
  next=u:life_reduce(state,event);
  geometry_changed=(1-equal(next.grid,state.grid))+(1-eq(next.hover_cell,state.hover_cell));
  view_changed=1-equal(next.camera,state.camera);
  if geometry_changed { u:life_submit_patch(state,next)? } else {
    if view_changed { u:life_submit_view(next)? }
  };
  if equal(event.kind,"frame") {
    port_send(port,{op:"frame_ack",revision: next.revision})
  };
  next
}

def u:life_on_resync(event,state) {
  "Provide life on resync behavior in this MLPL module.";
  u:life_submit(state)?;
  state
}

state=u:life_app_defaults();
u:life_submit(state)?;
on(port,"key",:u:life_on_event);
on(port,"frame",:u:life_on_event);
on(port,"pointer_move",:u:life_on_event);
on(port,"pointer_down",:u:life_on_event);
on(port,"pointer_up",:u:life_on_event);
on(port,"wheel",:u:life_on_event);
on(port,"resize",:u:life_on_event);
on(port,"resync",:u:life_on_resync);
run(port,state)
