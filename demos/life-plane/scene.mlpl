# Renderer-neutral Life plane assembled entirely as generic lines in MLPL.
include "./controls.mlpl";
include "../../lib/native3d/geometry.mlpl";

def u:life_line_state() {
  "Provide life line state behavior in this MLPL module.";
  {positions: fill([0],0),starts: fill([0],0),ends: fill([0],0),edges: fill([0],0),colors: fill([0],0),thicknesses: fill([0],0),ids: fill([0],0),count:0}
}

def u:life_add_segment(state,start,end,color,thickness) {
  "Provide life add segment behavior in this MLPL module.";
  u:life_add_segment_id(state,start,end,color,thickness,state.count)
}

def u:life_add_segment_id(state,start,end,color,thickness,id) {
  "Provide life add segment id behavior in this MLPL module.";
  vertex=state.count*2;
  {positions: concat(state.positions,concat(start,end)),starts: concat(state.starts,start),ends: concat(state.ends,end),edges: concat(state.edges,[vertex,vertex+1]),colors: concat(state.colors,color),thicknesses: concat(state.thicknesses,thickness),ids: concat(state.ids,id),count: state.count+1}
}

def u:life_add_grid(state,rows,columns) {
  "Provide life add grid behavior in this MLPL module.";
  size=0.2;
  half_width=columns*size/2;
  half_depth=rows*size/2;
  column=0;
  while lt(column,columns+1) {
    x=column*size-half_width;
    state=u:life_add_segment(state,[x,0,0-half_depth],[x,0,half_depth],[0.25,0.32,0.4,1],1);
    column=column+1
  };
  row=0;
  while lt(row,rows+1) {
    z=row*size-half_depth;
    state=u:life_add_segment(state,[0-half_width,0,z],[half_width,0,z],[0.25,0.32,0.4,1],1);
    row=row+1
  };
  state
}

def u:life_add_square_id(state,grid,cell,color,thickness,height,inset,id_base) {
  "Provide life add square id behavior in this MLPL module.";
  size=0.2;
  row=floor(cell/grid.columns);
  column=cell-row*grid.columns;
  x0=column*size-grid.columns*size/2+inset;
  x1=(column+1)*size-grid.columns*size/2-inset;
  z0=row*size-grid.rows*size/2+inset;
  z1=(row+1)*size-grid.rows*size/2-inset;
  state=u:life_add_segment_id(state,[x0,height,z0],[x1,height,z0],color,thickness,id_base);
  state=u:life_add_segment_id(state,[x1,height,z0],[x1,height,z1],color,thickness,id_base+1);
  state=u:life_add_segment_id(state,[x1,height,z1],[x0,height,z1],color,thickness,id_base+2);
  u:life_add_segment_id(state,[x0,height,z1],[x0,height,z0],color,thickness,id_base+3)
}

def u:life_grid_line_count(grid) {
  "Provide life grid line count behavior in this MLPL module.";
  grid.rows+grid.columns+2
}
def u:life_cell_line_id(grid,cell) {
  "Provide life cell line id behavior in this MLPL module.";
  u:life_grid_line_count(grid)+cell*4
}
def u:life_hover_line_id(grid) {
  "Provide life hover line id behavior in this MLPL module.";
  u:life_grid_line_count(grid)+grid.rows*grid.columns*4
}

def u:life_add_cells(state,grid,cell) {
  "Provide life add cells behavior in this MLPL module.";
  while lt(cell,grid.rows*grid.columns) {
    state=if take(grid.cells,0,cell) { u:life_add_square_id(state,grid,cell,[0.15,0.95,0.5,1],3,0.02,0.02,u:life_cell_line_id(grid,cell)) } else {
      state
    };
    cell=cell+1
  };
  state
}

def u:life_add_hover(state,grid,hover_cell) {
  "Provide life add hover behavior in this MLPL module.";
  if lt(hover_cell,0)+gt(hover_cell,grid.rows*grid.columns-1) {
    state
  } else { u:life_add_square_id(state,grid,hover_cell,[1,0.85,0.15,1],2,0.04,0.01,u:life_hover_line_id(grid)) }
}

def u:life_patch_remove_square(removes,id_base) {
  "Provide life patch remove square behavior in this MLPL module.";
  concat(removes,[id_base,id_base+1,id_base+2,id_base+3])
}

def u:life_scene_patch(before,after) {
  "Provide life scene patch behavior in this MLPL module.";
  lines=u:life_line_state();
  removes=fill([0],0);
  cell=0;
  while lt(cell,after.grid.rows*after.grid.columns) {
    old=take(before.grid.cells,0,cell);
    new=take(after.grid.cells,0,cell);
    if 1-eq(old,new) {
      id=u:life_cell_line_id(after.grid,cell);
      if new {
        lines=u:life_add_square_id(lines,after.grid,cell,[0.15,0.95,0.5,1],3,0.02,0.02,id)
      } else {
        removes=u:life_patch_remove_square(removes,id)
      }
    };
    cell=cell+1
  };
  if 1-eq(before.hover_cell,after.hover_cell) {
    hover_id=u:life_hover_line_id(after.grid);
    if gt(before.hover_cell,-1) {
      removes=u:life_patch_remove_square(removes,hover_id)
    };
    if gt(after.hover_cell,-1) {
      lines=u:life_add_square_id(lines,after.grid,after.hover_cell,[1,0.85,0.15,1],2,0.04,0.01,hover_id)
    }
  };
  {op:"patch_scene",base_revision: before.revision,target_revision: after.revision,ids: lines.ids,starts: reshape(lines.starts,[lines.count,3]),ends: reshape(lines.ends,[lines.count,3]),colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,remove_ids: removes}
}

def u:life_scene(state) {
  "Provide life scene behavior in this MLPL module.";
  if (1-u:life_valid(state.grid))+(1-eq(state.hover_cell,floor(state.hover_cell)))+lt(state.hover_cell,-1)+gt(state.hover_cell,state.grid.rows*state.grid.columns-1) {
    err({kind:"life_scene",message:"invalid Life grid or hover cell"})
  } else {
    lines=u:life_add_grid(u:life_line_state(),state.grid.rows,state.grid.columns);
    lines=u:life_add_cells(lines,state.grid,0);
    lines=u:life_add_hover(lines,state.grid,state.hover_cell);
    style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids};
    u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0)
  }
}
