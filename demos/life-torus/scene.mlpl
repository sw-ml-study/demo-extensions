# MLPL application semantics for demos life torus scene.
include "./controls.mlpl";
include "../../lib/native3d/geometry.mlpl";

def u:life_torus_line_state() {
  "Provide life torus line state behavior in this MLPL module.";
  {positions: fill([0],0),starts: fill([0],0),ends: fill([0],0),edges: fill([0],0),colors: fill([0],0),thicknesses: fill([0],0),ids: fill([0],0),count:0}
}

def u:life_torus_add_segment_id(state,start,end,color,thickness,id) {
  "Provide life torus add segment id behavior in this MLPL module.";
  vertex=state.count*2;
  {positions: concat(state.positions,concat(start,end)),starts: concat(state.starts,start),ends: concat(state.ends,end),edges: concat(state.edges,[vertex,vertex+1]),colors: concat(state.colors,color),thicknesses: concat(state.thicknesses,thickness),ids: concat(state.ids,id),count: state.count+1}
}
def u:life_torus_add_segment(state,start,end,color,thickness) {
  "Provide life torus add segment behavior in this MLPL module.";
  u:life_torus_add_segment_id(state,start,end,color,thickness,state.count)
}
def u:life_torus_grid_line_count(grid) {
  "Provide life torus grid line count behavior in this MLPL module.";
  grid.rows*grid.columns*2
}
def u:life_torus_cell_line_id(grid,cell) {
  "Provide life torus cell line id behavior in this MLPL module.";
  u:life_torus_grid_line_count(grid)+cell*4
}

def u:life_torus_add_lattice(state,grid,row,column) {
  "Provide life torus add lattice behavior in this MLPL module.";
  while lt(row,grid.rows) {
    column=0;
    while lt(column,grid.columns) {
      point=u:life_torus_point(row,column,grid.rows,grid.columns,0);
      around=u:life_torus_point(row,u:life_wrap(column+1,grid.columns),grid.rows,grid.columns,0);
      across=u:life_torus_point(u:life_wrap(row+1,grid.rows),column,grid.rows,grid.columns,0);
      state=u:life_torus_add_segment(state,point,around,[0.22,0.3,0.4,1],1);
      state=u:life_torus_add_segment(state,point,across,[0.22,0.3,0.4,1],1);
      column=column+1
    };
    row=row+1
  };
  state
}

def u:life_torus_add_cell(state,grid,cell) {
  "Provide life torus add cell behavior in this MLPL module.";
  row=floor(cell/grid.columns);
  column=cell-row*grid.columns;
  next_row=u:life_wrap(row+1,grid.rows);
  next_column=u:life_wrap(column+1,grid.columns);
  p00=u:life_torus_point(row,column,grid.rows,grid.columns,0.04);
  p01=u:life_torus_point(row,next_column,grid.rows,grid.columns,0.04);
  p11=u:life_torus_point(next_row,next_column,grid.rows,grid.columns,0.04);
  p10=u:life_torus_point(next_row,column,grid.rows,grid.columns,0.04);
  id=u:life_torus_cell_line_id(grid,cell);
  state=u:life_torus_add_segment_id(state,p00,p01,[0.15,0.95,0.5,1],3,id);
  state=u:life_torus_add_segment_id(state,p01,p11,[0.15,0.95,0.5,1],3,id+1);
  state=u:life_torus_add_segment_id(state,p11,p10,[0.15,0.95,0.5,1],3,id+2);
  u:life_torus_add_segment_id(state,p10,p00,[0.15,0.95,0.5,1],3,id+3)
}

def u:life_torus_add_cells(state,grid,cell) {
  "Provide life torus add cells behavior in this MLPL module.";
  while lt(cell,grid.rows*grid.columns) {
    if take(grid.cells,0,cell) {
      state=u:life_torus_add_cell(state,grid,cell)
    };
    cell=cell+1
  };
  state
}

def u:life_torus_scene_patch(before,after) {
  "Provide life torus scene patch behavior in this MLPL module.";
  lines=u:life_torus_line_state();
  removes=fill([0],0);
  cell=0;
  while lt(cell,after.grid.rows*after.grid.columns) {
    old=take(before.grid.cells,0,cell);
    new=take(after.grid.cells,0,cell);
    if 1-eq(old,new) {
      id=u:life_torus_cell_line_id(after.grid,cell);
      if new {
        lines=u:life_torus_add_cell(lines,after.grid,cell)
      } else {
        removes=concat(removes,[id,id+1,id+2,id+3])
      }
    };
    cell=cell+1
  };
  {op:"patch_scene",base_revision: before.revision,target_revision: after.revision,ids: lines.ids,starts: reshape(lines.starts,[lines.count,3]),ends: reshape(lines.ends,[lines.count,3]),colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,remove_ids: removes}
}

def u:life_torus_scene(state) {
  "Provide life torus scene behavior in this MLPL module.";
  if 1-u:life_valid(state.grid) {
    err({kind:"life_torus_scene",message:"invalid toroidal Life grid"})
  } else {
    lines=u:life_torus_add_lattice(u:life_torus_line_state(),state.grid,0,0);
    lines=u:life_torus_add_cells(lines,state.grid,0);
    style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids};
    u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0)
  }
}
