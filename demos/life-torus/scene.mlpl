include "./controls.mlpl";
include "../../lib/native3d/geometry.mlpl";

def u:life_torus_line_state() { {positions: fill([0],0),edges: fill([0],0),colors: fill([0],0),thicknesses: fill([0],0),ids: fill([0],0),count:0} }

def u:life_torus_add_segment(state,start,end,color,thickness) { vertex=state.count*2; {positions: concat(state.positions,concat(start,end)),edges: concat(state.edges,[vertex,vertex+1]),colors: concat(state.colors,color),thicknesses: concat(state.thicknesses,thickness),ids: concat(state.ids,state.count),count: state.count+1} }

def u:life_torus_add_lattice(state,grid,row,column) {
  while lt(row,grid.rows) { column=0; while lt(column,grid.columns) { point=u:life_torus_point(row,column,grid.rows,grid.columns,0); around=u:life_torus_point(row,u:life_wrap(column+1,grid.columns),grid.rows,grid.columns,0); across=u:life_torus_point(u:life_wrap(row+1,grid.rows),column,grid.rows,grid.columns,0); state=u:life_torus_add_segment(state,point,around,[0.22,0.3,0.4,1],1); state=u:life_torus_add_segment(state,point,across,[0.22,0.3,0.4,1],1); column=column+1 }; row=row+1 };
  state
}

def u:life_torus_add_cells(state,grid,cell) {
  while lt(cell,grid.rows*grid.columns) { if take(grid.cells,0,cell) { row=floor(cell/grid.columns); column=cell-row*grid.columns; next_row=u:life_wrap(row+1,grid.rows); next_column=u:life_wrap(column+1,grid.columns); p00=u:life_torus_point(row,column,grid.rows,grid.columns,0.04); p01=u:life_torus_point(row,next_column,grid.rows,grid.columns,0.04); p11=u:life_torus_point(next_row,next_column,grid.rows,grid.columns,0.04); p10=u:life_torus_point(next_row,column,grid.rows,grid.columns,0.04); state=u:life_torus_add_segment(state,p00,p01,[0.15,0.95,0.5,1],3); state=u:life_torus_add_segment(state,p01,p11,[0.15,0.95,0.5,1],3); state=u:life_torus_add_segment(state,p11,p10,[0.15,0.95,0.5,1],3); state=u:life_torus_add_segment(state,p10,p00,[0.15,0.95,0.5,1],3) }; cell=cell+1 };
  state
}

def u:life_torus_scene(state) {
  if 1-u:life_valid(state.grid) { err({kind:"life_torus_scene",message:"invalid toroidal Life grid"}) } else { lines=u:life_torus_add_lattice(u:life_torus_line_state(),state.grid,0,0); lines=u:life_torus_add_cells(lines,state.grid,0); style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids}; u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0) }
}
