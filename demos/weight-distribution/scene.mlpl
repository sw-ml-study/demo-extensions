def u:wd_mode_scene(state) { lines=u:atlas_lines(); if equal(state.mode,"error") { red=[1,0.15,0.1,1]; lines=u:atlas_add(lines,[-4,0,-1],[4,6,1],red,10,10); lines=u:atlas_add(lines,[-4,6,1],[4,0,-1],red,10,11); lines=u:atlas_add(lines,[0,0,-3],[0,6,3],red,6,12) } else { if equal(state.mode,"loading") { cyan=[0.2,0.85,1,1]; yellow=[1,0.85,0.2,1]; lines=u:atlas_add(lines,[0,0,0],[0,4,0],yellow,8,10); lines=u:atlas_add(lines,[0,4,0],[2.5,2.5,0],cyan,8,11); lines=u:atlas_add(lines,[2.5,2.5,0],[1,1,0],cyan,8,12); lines=u:atlas_add(lines,[1,1,0],[0,0,0],yellow,8,13) } else { color=if equal(state.mode,"tensors") { [0.2,0.85,1,1] } else { [1,0.85,0.2,1] }; lines=u:atlas_add_box(lines,0,1,0,8,2,0.5,color,4,10) } }; style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids}; u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0) }
def u:wd_axes(lines) { white=[0.9,0.9,0.9,1]; green=[0.55,1,0.45,1]; blue=[0.2,0.75,1,1]; orange=[1,0.55,0.2,1]; yellow=[1,0.9,0.15,1]; lines=u:atlas_add(lines,[-5,0,0],[5,0,0],white,2,100); lines=u:atlas_add(lines,[-5,0,0],[-5,11,0],white,2,101); lines=u:atlas_add(lines,[-5,0,0],[-5,0,4],white,2,102); index=0; while lt(index,8) { x=-4.375+index*1.25; lines=u:atlas_add(lines,[x,0,-0.2],[x,0,0.2],green,2,110+index); index=index+1 }; index=0; while lt(index,6) { y=0.35+index*2; lines=u:atlas_add(lines,[-5.2,y,0],[-4.8,y,0],green,2,120+index); index=index+1 }; lines=u:atlas_add_digit(lines,1,-5.65,0.35,2000); lines=u:atlas_add_digit(lines,4,-5.65,2.35,2010); lines=u:atlas_add_digit(lines,1,-5.9,4.35,2020); lines=u:atlas_add_digit(lines,6,-5.4,4.35,2030); lines=u:atlas_add_digit(lines,6,-5.9,6.35,2040); lines=u:atlas_add_digit(lines,4,-5.4,6.35,2050); lines=u:atlas_add_digit(lines,2,-6.15,8.35,2060); lines=u:atlas_add_digit(lines,5,-5.65,8.35,2070); lines=u:atlas_add_digit(lines,6,-5.15,8.35,2080); lines=u:atlas_add_digit(lines,1,-6.4,10.35,2090); lines=u:atlas_add_digit(lines,0,-5.9,10.35,2100); lines=u:atlas_add_digit(lines,2,-5.4,10.35,2110); lines=u:atlas_add_digit(lines,4,-4.9,10.35,2120); lines=u:atlas_add(lines,[5.5,10.5,0],[6.4,10.5,0],blue,7,2190); lines=u:atlas_add(lines,[6.75,10.5,0],[7.15,10.5,0],blue,4,2200); lines=u:atlas_add(lines,[5.5,9.8,0],[6.4,9.8,0],orange,7,2210); lines=u:atlas_add(lines,[6.75,9.8,0],[7.15,9.8,0],orange,4,2220); lines=u:atlas_add(lines,[6.95,9.6,0],[6.95,10,0],orange,4,2221); lines=u:atlas_add(lines,[5.5,9.1,0],[6.4,9.1,0],yellow,7,2230); lines=u:atlas_add_s(lines,6.75,9.1,yellow,2240); lines=u:atlas_add_e(lines,7.2,9.1,yellow,2245); u:atlas_add_l(lines,7.65,9.1,yellow,2249) }
def u:wd_scene(state) { lines=u:wd_axes(u:atlas_lines()); index=0; while lt(index,8) { count=if lt(index,tally(state.tile.bin_counts)) { take(state.tile.bin_counts,0,index) } else { 0 }; height=if eq(count,0) { 0.15 } else { 0.35+log(count)/log(2) }; selected=eq(index,state.selected_bin); color=if selected { [1,0.9,0.15,1] } else { if lt(index,4) { [0.2,0.75,1,1] } else { [1,0.55,0.2,1] } }; lines=u:atlas_add_box(lines,-4.375+index*1.25,height/2,0,1,height,1,color,if selected { 4 } else { 2 },1000+index*12); index=index+1 }; style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids}; u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0) }

def u:wd_scene_patch(before,after) { old=u:wd_scene(before)?; new=u:wd_scene(after)?; patch={starts: fill([0],0),ends: fill([0],0),colors: fill([0],0),thicknesses: fill([0],0),ids: fill([0],0),removes: fill([0],0),count: 0}; index=0; while lt(index,tally(new.ids)) { id=take(new.ids,0,index); prior=u:atlas_scene_line_index(old,id); changed=lt(prior,0); if 1-changed { changed=(1-equal(take(new.colors,0,index),take(old.colors,0,prior)))+(1-eq(take(new.thicknesses,0,index),take(old.thicknesses,0,prior)))+(1-equal(take(new.positions,0,take(take(new.edges,0,index),0,0)),take(old.positions,0,take(take(old.edges,0,prior),0,0))))+(1-equal(take(new.positions,0,take(take(new.edges,0,index),0,1)),take(old.positions,0,take(take(old.edges,0,prior),0,1)))) }; if changed { patch=u:atlas_patch_add_line(patch,new,index) }; index=index+1 }; index=0; while lt(index,tally(old.ids)) { id=take(old.ids,0,index); if lt(u:atlas_scene_line_index(new,id),0) { patch={starts: patch.starts,ends: patch.ends,colors: patch.colors,thicknesses: patch.thicknesses,ids: patch.ids,removes: concat(patch.removes,id),count: patch.count} }; index=index+1 }; ok({op: "patch_scene",base_revision: before.revision,target_revision: after.revision,ids: patch.ids,starts: reshape(patch.starts,[patch.count,3]),ends: reshape(patch.ends,[patch.count,3]),colors: reshape(patch.colors,[patch.count,4]),thicknesses: patch.thicknesses,remove_ids: patch.removes}) }
def u:wd_tensor_help(state) { text=u:wd_text("WEIGHT DISTRIBUTION — CHOOSE TENSOR\nUP/DOWN CHOOSE | ENTER BOUNDED SAMPLE | M MODEL MENU\nFILE: ",u:wd_text(state.path,"\n")); limit=if lt(state.catalog.count,12) { state.catalog.count } else { 12 }; index=0; while lt(index,limit) { name=if equal(state.catalog.format,"gguf") { u:wd_gguf_name(state.catalog,index) } else { u:wd_safe_name(state.catalog,index) }; dtype=if equal(state.catalog.format,"gguf") { take(take(state.catalog.rows,0,index),0,2) } else { info=record_get(state.catalog.header,name)?; record_get(info,"dtype")? }; prefix=if eq(index,state.tensor_index) { ">> " } else { "   " }; support=if u:wd_dtype_supported(state.catalog.format,dtype) { " [SUPPORTED]" } else { " [BLOCKED]" }; row=u:wd_text(prefix,u:wd_text(name,u:wd_text(" | DTYPE ",u:wd_text(to_json(dtype)?,support)))); text=u:wd_text(text,u:wd_text(row,"\n")); index=index+1 }; text }
def u:wd_help(state) { if equal(state.mode,"files") { text="WEIGHT DISTRIBUTION — MODEL FILES\nUP/DOWN CHOOSE | ENTER OPEN BOUNDED CATALOG | ESC CLOSE\n"; index=0; while lt(index,list_len(state.files)) { prefix=if eq(index,state.file_index) { ">> " } else { "   " }; text=u:wd_text(text,u:wd_text(prefix,u:wd_text(list_get(state.files,index)?,"\n"))); index=index+1 }; text } else { if equal(state.mode,"loading") { u:wd_text("WEIGHT DISTRIBUTION — LOADING BOUNDED MODEL CATALOG\nROTATING MARKER = SCAN IN PROGRESS; FILE PAYLOAD IS NOT SLURPED\nFILE: ",state.path) } else { if equal(state.mode,"tensors") { u:wd_tensor_help(state) } else { if equal(state.mode,"error") { u:wd_text("WEIGHT DISTRIBUTION — ERROR (WINDOW RETAINED)\nRED 3D X = FAIL-CLOSED; NO UNSUPPORTED PAYLOAD WAS READ\nORIGINAL ERROR IS SHOWN BELOW\nR RESTART | M MODEL MENU | ESC QUIT\n\n",state.error) } else { u:wd_text("WEIGHT DISTRIBUTION — BOUNDED SAMPLE HISTOGRAM\nX=WEIGHT VALUE (MIN..MAX) | Y=LOG2 SAMPLE COUNT | Z=VIEW DEPTH\nWORLD LEGEND: BLUE - NEGATIVE | ORANGE + POSITIVE | YELLOW SEL SELECTED\nCOUNT TICKS: 1, 4, 16, 64, 256, 1024 SAMPLES\nCLICK OR UP/DOWN SELECT BIN | LEFT/BACKSPACE TENSORS | M MODEL MENU\nLEFT DRAG ORBIT | SHIFT+LEFT/MIDDLE PAN | WHEEL ZOOM | R RESET\nFILE: ",state.path) } } } } }
def u:wd_tensor_status(state) { dtype=u:wd_selected_dtype(state); name_attempt=u:wd_selected_name(state); name=if equal(type_of(name_attempt),"result") { name_attempt? } else { name_attempt }; text=u:wd_text("SELECTED TENSOR: ",name); u:wd_text(text,u:wd_text(" | DTYPE ",to_json(dtype)?)) }
def u:wd_histogram_status(state) { text=u:wd_text("TENSOR ",state.tile.name); text=u:wd_text(text,u:wd_text(" | DTYPE ",to_json(state.tile.dtype)?)); sampled=u:wd_text(to_json(state.tile.count)?,u:wd_text(" / ",to_json(state.tile.total)?)); text=u:wd_text(text,u:wd_text(" | SAMPLED ",sampled)); text=u:wd_text(text,u:wd_text(" | READ ",u:wd_text(to_json(state.tile.bytes_read)?," B"))); text=u:wd_text(text,u:wd_text("\nMIN ",to_json(state.tile.minimum)?)); text=u:wd_text(text,u:wd_text(" | MEAN ",to_json(state.tile.mean)?)); text=u:wd_text(text,u:wd_text(" | MAX ",to_json(state.tile.maximum)?)); text=u:wd_text(text,u:wd_text(" | ZEROS ",to_json(state.tile.zero_count)?)); width=(state.tile.maximum-state.tile.minimum)/8; lower=state.tile.minimum+state.selected_bin*width; upper=if eq(state.selected_bin,7) { state.tile.maximum } else { lower+width }; bin=u:wd_text("\nSELECTED BIN ",u:wd_text(to_json(state.selected_bin+1)?,u:wd_text("/8 RANGE ",u:wd_text(to_json(lower)?,u:wd_text("..",to_json(upper)?))))); u:wd_text(text,u:wd_text(bin,u:wd_text(" COUNT ",to_json(take(state.tile.bin_counts,0,state.selected_bin))?))) }
def u:wd_status(state) { if equal(state.mode,"files") { if eq(list_len(state.files),0) { "NO SAFETENSORS OR GGUF FILES FOUND" } else { u:wd_text("SELECTED MODEL: ",list_get(state.files,state.file_index)?) } } else { if equal(state.mode,"loading") { u:wd_text("LOADING CATALOG: ",state.path) } else { if equal(state.mode,"tensors") { u:wd_tensor_status(state) } else { if equal(state.mode,"error") { state.error } else { u:wd_histogram_status(state) } } } } }
