def u:wd_mode_scene(state) { lines=u:atlas_lines(); if equal(state.mode,"error") { red=[1,0.15,0.1,1]; lines=u:atlas_add(lines,[-4,0,-1],[4,6,1],red,10,10); lines=u:atlas_add(lines,[-4,6,1],[4,0,-1],red,10,11); lines=u:atlas_add(lines,[0,0,-3],[0,6,3],red,6,12) } else { color=if equal(state.mode,"tensors") { [0.2,0.85,1,1] } else { [1,0.85,0.2,1] }; lines=u:atlas_add_box(lines,0,1,0,8,2,0.5,color,4,10) }; style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids}; u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0) }
def u:wd_axes(lines) { white=[0.9,0.9,0.9,1]; green=[0.55,1,0.45,1]; lines=u:atlas_add(lines,[-5,0,0],[5,0,0],white,2,100); lines=u:atlas_add(lines,[-5,0,0],[-5,7,0],white,2,101); lines=u:atlas_add(lines,[-5,0,0],[-5,0,4],white,2,102); index=0; while lt(index,8) { x=-4.375+index*1.25; lines=u:atlas_add(lines,[x,0,-0.2],[x,0,0.2],green,2,110+index); index=index+1 }; index=0; while lt(index,7) { lines=u:atlas_add(lines,[-5.2,index+1,0],[-4.8,index+1,0],green,2,120+index); index=index+1 }; lines=u:atlas_add(lines,[-4,0,3.4],[0,0,3.4],[0.2,0.75,1,1],5,130); lines=u:atlas_add(lines,[0.5,0,3.4],[4.5,0,3.4],[1,0.55,0.2,1],5,131); lines=u:atlas_add(lines,[-4,0,3.8],[0,0,3.8],[1,0.9,0.15,1],5,132); lines=u:atlas_add(lines,[0.5,0,3.8],[4.5,0,3.8],[0.7,1,0.6,1],5,133); lines=u:atlas_add(lines,[-5,0,4],[-4.5,0,4],white,2,134); lines=u:atlas_add(lines,[4.5,0,4],[5,0,4],white,2,135); lines }
def u:wd_scene(state) { lines=u:wd_axes(u:atlas_lines()); index=0; while lt(index,8) { count=if lt(index,tally(state.tile.bin_counts)) { take(state.tile.bin_counts,0,index) } else { 0 }; height=if eq(count,0) { 0.15 } else { 0.35+log(count)/log(2) }; selected=eq(index,state.selected_bin); color=if selected { [1,0.9,0.15,1] } else { if lt(index,4) { [0.2,0.75,1,1] } else { [1,0.55,0.2,1] } }; lines=u:atlas_add_box(lines,-4.375+index*1.25,height/2,0,1,height,1,color,if selected { 4 } else { 2 },1000+index*12); index=index+1 }; style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids}; u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0) }
def u:wd_tensor_help(state) { text=u:wd_text("WEIGHT DISTRIBUTION — CHOOSE TENSOR\nUP/DOWN CHOOSE | ENTER BOUNDED SAMPLE | M MODEL MENU\nFILE: ",u:wd_text(state.path,"\n")); limit=if lt(state.catalog.count,12) { state.catalog.count } else { 12 }; index=0; while lt(index,limit) { name=if equal(state.catalog.format,"gguf") { u:wd_name(state.catalog.tensor_name_bytes,state.catalog.tensor_name_lengths,index,64) } else { u:wd_safe_name(state.catalog,index) }; dtype=if equal(state.catalog.format,"gguf") { take(take(state.catalog.rows,0,index),0,2) } else { info=record_get(state.catalog.header,name)?; record_get(info,"dtype")? }; prefix=if eq(index,state.tensor_index) { ">> " } else { "   " }; support=if u:wd_dtype_supported(state.catalog.format,dtype) { " [SUPPORTED]" } else { " [BLOCKED]" }; row=u:wd_text(prefix,u:wd_text(name,u:wd_text(" | DTYPE ",u:wd_text(to_json(dtype)?,support)))); text=u:wd_text(text,u:wd_text(row,"\n")); index=index+1 }; text }
def u:wd_help(state) { if equal(state.mode,"files") { text="WEIGHT DISTRIBUTION — MODEL FILES\nUP/DOWN CHOOSE | ENTER OPEN BOUNDED CATALOG | ESC CLOSE\n"; index=0; while lt(index,list_len(state.files)) { prefix=if eq(index,state.file_index) { ">> " } else { "   " }; text=u:wd_text(text,u:wd_text(prefix,u:wd_text(list_get(state.files,index)?,"\n"))); index=index+1 }; text } else { if equal(state.mode,"tensors") { u:wd_tensor_help(state) } else { if equal(state.mode,"error") { back=if eq(state.catalog.count,0) { "LEFT/BACKSPACE/M MODEL MENU" } else { "LEFT/BACKSPACE TENSOR MENU | M MODEL MENU" }; u:wd_text("WEIGHT DISTRIBUTION — CANNOT ANALYZE THIS SELECTION\nRED 3D X = FAIL-CLOSED; NO UNSUPPORTED PAYLOAD WAS READ\n",u:wd_text(back,u:wd_text("\n\n",state.error))) } else { u:wd_text("WEIGHT DISTRIBUTION — BOUNDED SAMPLE HISTOGRAM\nX=WEIGHT VALUE (MIN..MAX) | Y=LOG2 SAMPLE COUNT | Z=VIEW DEPTH\nBLUE NEGATIVE BINS | ORANGE POSITIVE BINS | YELLOW SELECTED BIN\nCLICK OR UP/DOWN SELECT BIN | LEFT/BACKSPACE TENSORS | M MODEL MENU\nLEFT DRAG ORBIT | SHIFT+LEFT/MIDDLE PAN | WHEEL ZOOM | R RESET\nFILE: ",state.path) } } } }
def u:wd_tensor_status(state) { dtype=u:wd_selected_dtype(state); text=u:wd_text("SELECTED TENSOR: ",u:wd_selected_name(state)); u:wd_text(text,u:wd_text(" | DTYPE ",to_json(dtype)?)) }
def u:wd_histogram_status(state) { text=u:wd_text("TENSOR ",u:wd_selected_name(state)); text=u:wd_text(text,u:wd_text(" | DTYPE ",to_json(state.tile.dtype)?)); sampled=u:wd_text(to_json(state.tile.count)?,u:wd_text(" / ",to_json(state.tile.total)?)); text=u:wd_text(text,u:wd_text(" | SAMPLED ",sampled)); text=u:wd_text(text,u:wd_text(" | READ ",u:wd_text(to_json(state.tile.bytes_read)?," B"))); text=u:wd_text(text,u:wd_text("\nMIN ",to_json(state.tile.minimum)?)); text=u:wd_text(text,u:wd_text(" | MEAN ",to_json(state.tile.mean)?)); text=u:wd_text(text,u:wd_text(" | MAX ",to_json(state.tile.maximum)?)); text=u:wd_text(text,u:wd_text(" | ZEROS ",to_json(state.tile.zero_count)?)); width=(state.tile.maximum-state.tile.minimum)/8; lower=state.tile.minimum+state.selected_bin*width; upper=if eq(state.selected_bin,7) { state.tile.maximum } else { lower+width }; bin=u:wd_text("\nSELECTED BIN ",u:wd_text(to_json(state.selected_bin+1)?,u:wd_text("/8 RANGE ",u:wd_text(to_json(lower)?,u:wd_text("..",to_json(upper)?))))); u:wd_text(text,u:wd_text(bin,u:wd_text(" COUNT ",to_json(take(state.tile.bin_counts,0,state.selected_bin))?))) }
def u:wd_status(state) { if equal(state.mode,"files") { if eq(list_len(state.files),0) { "NO SAFETENSORS OR GGUF FILES FOUND" } else { u:wd_text("SELECTED MODEL: ",list_get(state.files,state.file_index)?) } } else { if equal(state.mode,"tensors") { u:wd_tensor_status(state) } else { if equal(state.mode,"error") { state.error } else { u:wd_histogram_status(state) } } } }
