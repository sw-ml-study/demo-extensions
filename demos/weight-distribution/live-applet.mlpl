# MLPL application semantics for demos weight distribution live applet.
def u:wd_submit(state) {
  "Provide wd submit behavior in this MLPL module.";
  scene=if equal(state.mode,"histogram") { u:wd_scene(state)? } else { u:wd_mode_scene(state)? };
  speed=if equal(state.mode,"loading") {
    2
  } else {
    0
  };
  port_send(port,{op: "set_scene",positions: scene.positions,edges: scene.edges,colors: scene.colors,thicknesses: scene.thicknesses,ids: scene.ids,rotation_y_speed: speed,revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:wd_help(state),status: u:wd_status(state)});
  ok(state)
}
def u:wd_submit_view(state) {
  "Provide wd submit view behavior in this MLPL module.";
  port_send(port,{op: "set_view",revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:wd_help(state),status: u:wd_status(state)});
  ok(state)
}
def u:wd_key(event,state) {
  "Provide wd key behavior in this MLPL module.";
  key=event.key;
  next=state;
  if equal(state.mode,"files") {
    index=state.file_index;
    if equal(key,"arrow_down")*lt(index+1,list_len(state.files)) {
      index=index+1
    };
    if equal(key,"arrow_up")*gt(index,0) {
      index=index-1
    };
    next=u:wd_restate(state,"files",index,0,state.tile,state.bins,0,state.camera,"");
    if equal(key,"enter")*gt(list_len(state.files),0) {
      next=u:wd_loading(next);
      u:wd_submit(next)?;
      next=u:wd_open_file(next)
    }
  } else {
    if equal(state.mode,"tensors") {
      index=state.tensor_index;
      if equal(key,"arrow_down")*lt(index+1,state.catalog.count) {
        index=index+1
      };
      if equal(key,"arrow_up")*gt(index,0) {
        index=index-1
      };
      next=u:wd_restate(state,"tensors",state.file_index,index,state.tile,state.bins,0,state.camera,"");
      if equal(key,"enter")*gt(state.catalog.count,0) {
        next=u:wd_analyze(next)
      };
      if equal(key,"m") {
        next=u:wd_defaults(state.files)
      }
    } else {
      if equal(key,"m")+equal(key,"r")*equal(state.mode,"error") {
        next=u:wd_defaults(state.files)
      } else {
        if equal(key,"arrow_left")+equal(key,"backspace") {
          next=if equal(state.mode,"error")*eq(state.catalog.count,0) { u:wd_defaults(state.files) } else { u:wd_restate(state,"tensors",state.file_index,state.tensor_index,state.tile,state.bins,0,state.camera,"") }
        } else {
          if equal(state.mode,"histogram") {
            selected=state.selected_bin;
            if equal(key,"arrow_down")*lt(selected,7) {
              selected=selected+1
            };
            if equal(key,"arrow_up")*gt(selected,0) {
              selected=selected-1
            };
            camera=if equal(key,"r") { u:wd_defaults(state.files).camera } else {
              state.camera
            };
            next=u:wd_restate(state,"histogram",state.file_index,state.tensor_index,state.tile,state.bins,selected,camera,"")
          }
        }
      }
    }
  };
  if equal(next.mode,"histogram")*equal(state.mode,"histogram") {
    port_send(port,u:wd_scene_patch(state,next)?);
    u:wd_submit_view(next)?
  } else { u:wd_submit(next)? };
  next
}
def u:wd_dispatch(event,state) {
  "Provide wd dispatch behavior in this MLPL module.";
  if equal(event.kind,"key") {
    attempted=u:wd_key(event,state);
    next=if equal(type_of(attempted),"result") {
      attempted?
    } else {
      attempted
    };
    ok(next)
  } else {
    attempted=u:wd_pointer_reduce(event,state);
    next=if equal(type_of(attempted),"result") {
      attempted?
    } else {
      attempted
    };
    if equal(next.mode,"histogram")*(equal(event.kind,"pointer_down")+equal(event.kind,"pointer_move")+equal(event.kind,"pointer_up")+equal(event.kind,"wheel")) {
      if 1-eq(next.selected_bin,state.selected_bin) {
        port_send(port,u:wd_scene_patch(state,next)?)
      };
      u:wd_submit_view(next)?
    };
    ok(next)
  }
}
def u:wd_event(event,state) {
  "Provide wd event behavior in this MLPL module.";
  attempted=u:wd_dispatch(event,state);
  next=u:wd_event_result(state,attempted);
  if is_err(attempted) {
    ignored=u:wd_submit(next)
  };
  next
}
state=u:wd_defaults(weight_files);
u:wd_submit(state)?;
on(port,"key",:u:wd_event);
on(port,"pointer_move",:u:wd_event);
on(port,"pointer_down",:u:wd_event);
on(port,"pointer_up",:u:wd_event);
on(port,"wheel",:u:wd_event);
on(port,"resize",:u:wd_event);
on(port,"close",:u:wd_event);
run(port,state)
