def u:wd_submit(state) { scene=if equal(state.mode,"histogram") { u:wd_scene(state)? } else { u:wd_mode_scene(state)? }; speed=if equal(state.mode,"loading") { 2 } else { 0 }; port_send(port,{op: "set_scene",positions: scene.positions,edges: scene.edges,colors: scene.colors,thicknesses: scene.thicknesses,ids: scene.ids,rotation_y_speed: speed,revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:wd_help(state),status: u:wd_status(state)}); ok(state) }
def u:wd_submit_view(state) { port_send(port,{op: "set_view",revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:wd_help(state),status: u:wd_status(state)}); ok(state) }
def u:wd_key(event,state) { key=event.key; next=state; if equal(state.mode,"files") { index=state.file_index; if equal(key,"arrow_down")*lt(index+1,list_len(state.files)) { index=index+1 }; if equal(key,"arrow_up")*gt(index,0) { index=index-1 }; next=u:wd_restate(state,"files",index,0,state.tile,state.bins,0,state.camera,""); if equal(key,"enter")*gt(list_len(state.files),0) { next=u:wd_loading(next); u:wd_submit(next)?; next=u:wd_open_file(next) } } else { if equal(state.mode,"tensors") { index=state.tensor_index; if equal(key,"arrow_down")*lt(index+1,state.catalog.count) { index=index+1 }; if equal(key,"arrow_up")*gt(index,0) { index=index-1 }; next=u:wd_restate(state,"tensors",state.file_index,index,state.tile,state.bins,0,state.camera,""); if equal(key,"enter")*gt(state.catalog.count,0) { next=u:wd_analyze(next) }; if equal(key,"m") { next=u:wd_defaults(state.files) } } else { if equal(key,"m") { next=u:wd_defaults(state.files) } else { if equal(key,"arrow_left")+equal(key,"backspace") { next=if equal(state.mode,"error")*eq(state.catalog.count,0) { u:wd_defaults(state.files) } else { u:wd_restate(state,"tensors",state.file_index,state.tensor_index,state.tile,state.bins,0,state.camera,"") } } else { if equal(state.mode,"histogram") { selected=state.selected_bin; if equal(key,"arrow_down")*lt(selected,7) { selected=selected+1 }; if equal(key,"arrow_up")*gt(selected,0) { selected=selected-1 }; camera=if equal(key,"r") { u:wd_defaults(state.files).camera } else { state.camera }; next=u:wd_restate(state,"histogram",state.file_index,state.tensor_index,state.tile,state.bins,selected,camera,"") } } } } }; if equal(next.mode,"histogram")*equal(state.mode,"histogram") { port_send(port,u:wd_scene_patch(state,next)?); u:wd_submit_view(next)? } else { u:wd_submit(next)? }; next }
def u:wd_pointer(event,state) { if 1-equal(state.mode,"histogram") { state } else { if equal(event.kind,"pointer_down") { next=u:wd_interaction(state,u:n3d_camera_reduce(state.camera,event),state.selected_bin,event.x,event.y,0); u:wd_submit_view(next)?; next } else { if equal(event.kind,"pointer_move")*state.camera.dragging { distance2=(event.x-state.press_x)*(event.x-state.press_x)+(event.y-state.press_y)*(event.y-state.press_y); dragged=if state.dragged+gt(distance2,16) { 1 } else { 0 }; camera=if dragged { u:n3d_camera_reduce(state.camera,event) } else { state.camera }; next=u:wd_interaction(state,camera,state.selected_bin,state.press_x,state.press_y,dragged); u:wd_submit_view(next)?; next } else { if equal(event.kind,"pointer_up") { camera=u:n3d_camera_reduce(state.camera,event); picked=if state.dragged { -1 } else { u:wd_pick(state,event)? }; selected=if lt(picked,0) { state.selected_bin } else { picked }; next=u:wd_interaction(state,camera,selected,state.press_x,state.press_y,0); if eq(selected,state.selected_bin) { u:wd_submit_view(next)? } else { port_send(port,u:wd_scene_patch(state,next)?); u:wd_submit_view(next)? }; next } else { if equal(event.kind,"wheel") { next=u:wd_interaction(state,u:n3d_camera_reduce(state.camera,event),state.selected_bin,state.press_x,state.press_y,state.dragged); u:wd_submit_view(next)?; next } else { state } } } } } }
state=u:wd_defaults(weight_files); u:wd_submit(state)?; on(port,"key",:u:wd_key); on(port,"pointer_move",:u:wd_pointer); on(port,"pointer_down",:u:wd_pointer); on(port,"pointer_up",:u:wd_pointer); on(port,"wheel",:u:wd_pointer); on(port,"close",:u:wd_pointer); run(port,state)
