# MLPL-owned deterministic point arrays and atomic selection patches.
include "./model.mlpl";

def u:point_cloud_scene(state) {
  "Generate bounded deterministic helix arrays with a visible selected point.";
  positions=fill([0],0);
  sizes=fill([0],0);
  colors=fill([0],0);
  opacities=fill([0],0);
  ids=range(24)+1000;
  index=0;
  while lt(index,24) {
    angle=index*6.283185307179586/12;
    layer=floor(index/12);
    radius=1.2+layer*0.45;
    positions=concat(positions,[cos(angle)*radius,(index-11.5)*0.1,sin(angle)*radius]);
    selected=eq(1000+index,state.selected_id);
    sizes=concat(sizes,18+selected*14+layer*4);
    color=if selected {
      [1,0.9,0.15,1]
    } else {
      if layer {
        [0.25,0.65,1,1]
      } else {
        [1,0.3,0.45,1]
      }
    };
    colors=concat(colors,color);
    opacities=concat(opacities,0.72+selected*0.28);
    index=index+1
  };
  ok({positions: reshape(positions,[24,3]),sizes: sizes,colors: reshape(colors,[24,4]),opacities: opacities,ids: ids})
}

def u:point_cloud_set_command(state) {
  "Build a complete generic point-scene command from MLPL arrays.";
  scene=u:point_cloud_scene(state)?;
  ok({op:"set_points",positions: scene.positions,sizes: scene.sizes,colors: scene.colors,opacities: scene.opacities,ids: scene.ids,revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:point_cloud_help(state)})
}

def u:point_cloud_view_command(state) {
  "Build a geometry-preserving generic view command.";
  {op:"set_view",revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:point_cloud_help(state)}
}

def u:point_cloud_patch(before,after) {
  "Build one bounded atomic patch reflecting MLPL-owned selection styling.";
  scene=u:point_cloud_scene(after)?;
  ok({op:"patch_points",base_revision: before.revision,target_revision: after.revision,ids: scene.ids,positions: scene.positions,sizes: scene.sizes,colors: scene.colors,opacities: scene.opacities,remove_ids: fill([0],0)})
}
