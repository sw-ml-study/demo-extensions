# MLPL owns application controls. Native code supplies only generic events and rendering primitives.
include "scene.mlpl";
include "../../lib/native3d/camera.mlpl";

def u:wireframe_cube_clamp(value,low,high) {
  "Provide wireframe cube clamp behavior in this MLPL module.";
  if lt(value,low) {
    low
  } else {
    if gt(value,high) {
      high
    } else {
      value
    }
  }
}

def u:wireframe_cube_palette(index) {
  "Provide wireframe cube palette behavior in this MLPL module.";
  if eq(index,0) {
    [0.2,0.8,1,1]
  } else {
    if eq(index,1) {
      [1,0.4,0.2,1]
    } else {
      if eq(index,2) {
        [0.5,1,0.3,1]
      } else {
        [0.9,0.4,1,1]
      }
    }
  }
}

def u:wireframe_cube_control_state(width,height,length,speed,paused,color_index,thickness,viewport_width,viewport_height,close_requested,revision) {
  "Provide wireframe cube control state behavior in this MLPL module.";
  u:wireframe_cube_control_state_camera(width,height,length,speed,paused,color_index,thickness,viewport_width,viewport_height,close_requested,revision,u:n3d_camera_defaults())
}

def u:wireframe_cube_control_state_camera(width,height,length,speed,paused,color_index,thickness,viewport_width,viewport_height,close_requested,revision,camera) {
  "Provide wireframe cube control state camera behavior in this MLPL module.";
  {width: width,height: height,length: length,rotation_speed: speed,paused: paused,color_index: color_index,line_color: u:wireframe_cube_palette(color_index),line_thickness: thickness,viewport_width: viewport_width,viewport_height: viewport_height,close_requested: close_requested,revision: revision,camera: camera}
}

def u:wireframe_cube_control_defaults() {
  "Provide wireframe cube control defaults behavior in this MLPL module.";
  u:wireframe_cube_control_state(2,2,2,0.6,0,0,2,800,600,0,0)
}

def u:wireframe_cube_control_change(state,width,height,length,speed,paused,color_index,thickness,close_requested) {
  "Provide wireframe cube control change behavior in this MLPL module.";
  u:wireframe_cube_control_state_camera(width,height,length,speed,paused,color_index,thickness,state.viewport_width,state.viewport_height,close_requested,state.revision+1,state.camera)
}

def u:wireframe_cube_reduce_key(state,key) {
  "Provide wireframe cube reduce key behavior in this MLPL module.";
  if equal(key,"width_up")+equal(key,"w") { u:wireframe_cube_control_change(state,u:wireframe_cube_clamp(state.width+0.25,0.25,100),state.height,state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
    if equal(key,"width_down")+equal(key,"s") { u:wireframe_cube_control_change(state,u:wireframe_cube_clamp(state.width-0.25,0.25,100),state.height,state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
      if equal(key,"height_up")+equal(key,"arrow_up") { u:wireframe_cube_control_change(state,state.width,u:wireframe_cube_clamp(state.height+0.25,0.25,100),state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
        if equal(key,"height_down")+equal(key,"arrow_down") { u:wireframe_cube_control_change(state,state.width,u:wireframe_cube_clamp(state.height-0.25,0.25,100),state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
          if equal(key,"length_up")+equal(key,"d") { u:wireframe_cube_control_change(state,state.width,state.height,u:wireframe_cube_clamp(state.length+0.25,0.25,100),state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
            if equal(key,"length_down")+equal(key,"a") { u:wireframe_cube_control_change(state,state.width,state.height,u:wireframe_cube_clamp(state.length-0.25,0.25,100),state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
              if equal(key,"speed_up")+equal(key,"equal") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,u:wireframe_cube_clamp(state.rotation_speed+0.1,-10,10),state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
                if equal(key,"speed_down")+equal(key,"minus") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,u:wireframe_cube_clamp(state.rotation_speed-0.1,-10,10),state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
                  if equal(key,"pause")+equal(key,"space") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,state.rotation_speed,1-state.paused,state.color_index,state.line_thickness,state.close_requested) } else {
                    if equal(key,"color_cycle")+equal(key,"c") {
                      next=if eq(state.color_index,3) {
                        0
                      } else {
                        state.color_index+1
                      };
                      u:wireframe_cube_control_change(state,state.width,state.height,state.length,state.rotation_speed,state.paused,next,state.line_thickness,state.close_requested)
                    } else {
                      if equal(key,"thickness_up")+equal(key,"bracket_right") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,state.rotation_speed,state.paused,state.color_index,u:wireframe_cube_clamp(state.line_thickness+0.5,0.5,20),state.close_requested) } else {
                        if equal(key,"thickness_down")+equal(key,"bracket_left") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,state.rotation_speed,state.paused,state.color_index,u:wireframe_cube_clamp(state.line_thickness-0.5,0.5,20),state.close_requested) } else {
                          if equal(key,"close")+equal(key,"escape") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,1) } else {
                            if equal(key,"reset")+equal(key,"r") {
                              defaults=u:wireframe_cube_control_defaults();
                              u:wireframe_cube_control_state(defaults.width,defaults.height,defaults.length,defaults.rotation_speed,defaults.paused,defaults.color_index,defaults.line_thickness,state.viewport_width,state.viewport_height,0,state.revision+1)
                            } else {
                              state
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

def u:wireframe_cube_reduce(state,event) {
  "Provide wireframe cube reduce behavior in this MLPL module.";
  pointer=equal(event.kind,"pointer_down")+equal(event.kind,"pointer_up")+equal(event.kind,"pointer_move")+equal(event.kind,"wheel");
  if pointer {
    camera=u:n3d_camera_reduce(state.camera,event);
    u:wireframe_cube_control_state_camera(state.width,state.height,state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,state.viewport_width,state.viewport_height,state.close_requested,state.revision+1,camera)
  } else {
    if equal(event.kind,"key") { u:wireframe_cube_reduce_key(state,event.key) } else {
      if equal(event.kind,"resize") { u:wireframe_cube_control_state_camera(state.width,state.height,state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,u:wireframe_cube_clamp(event.width,1,16384),u:wireframe_cube_clamp(event.height,1,16384),state.close_requested,state.revision+1,state.camera) } else {
        if equal(event.kind,"close") { u:wireframe_cube_control_change(state,state.width,state.height,state.length,state.rotation_speed,state.paused,state.color_index,state.line_thickness,1) } else {
          state
        }
      }
    }
  }
}

def u:wireframe_cube_bulk_update(state) {
  "Provide wireframe cube bulk update behavior in this MLPL module.";
  active_speed=if state.paused {
    0
  } else {
    state.rotation_speed
  };
  scene=u:wireframe_cube_scene({width: state.width,height: state.height,length: state.length,rotation_speed: active_speed,line_color: state.line_color,line_thickness: state.line_thickness})?;
  ok({positions: reshape(scene.positions.values,scene.positions.shape),edges: reshape(scene.edges.values,scene.edges.shape),colors: matmul(ones([12,1]),reshape(state.line_color,[1,4])),thicknesses: fill([12],state.line_thickness),ids: range(12),rotation_y_speed: active_speed,revision: state.revision,camera: u:n3d_camera_record(state.camera)})
}
