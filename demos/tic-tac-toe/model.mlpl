# Pure tic-tac-toe model. Cells are row-major: 0 empty, 1 X, -1 O.

def u:ttt_empty_board() {
  "Provide ttt empty board behavior in this MLPL module.";
  fill([9],0)
}

def u:ttt_values_valid(board,index) {
  "Provide ttt values valid behavior in this MLPL module.";
  valid=1;
  while lt(index,9)*valid {
    value=take(board,0,index);
    valid=eq(value,-1)+eq(value,0)+eq(value,1);
    index=index+1
  };
  valid
}

def u:ttt_line_winner(board,a,b,c) {
  "Provide ttt line winner behavior in this MLPL module.";
  total=take(board,0,a)+take(board,0,b)+take(board,0,c);
  if eq(total,3) {
    1
  } else {
    if eq(total,-3) {
      -1
    } else {
      0
    }
  }
}

def u:ttt_winner_from(board,line) {
  "Provide ttt winner from behavior in this MLPL module.";
  winner=0;
  while lt(line,8)*(1-winner*winner) {
    a=take([0,3,6,0,1,2,0,2],0,line);
    b=take([1,4,7,3,4,5,4,4],0,line);
    c=take([2,5,8,6,7,8,8,6],0,line);
    winner=u:ttt_line_winner(board,a,b,c);
    line=line+1
  };
  winner
}

def u:ttt_winner(board) {
  "Provide ttt winner behavior in this MLPL module.";
  u:ttt_winner_from(board,0)
}

def u:ttt_valid_board(board) {
  "Provide ttt valid board behavior in this MLPL module.";
  if (1-equal(shape(board),[9])) {
    0
  } else {
    if 1-u:ttt_values_valid(board,0) {
      0
    } else {
      xs=reduce(:add,eq(board,1));
      os=reduce(:add,eq(board,-1));
      winner=u:ttt_winner(board);
      difference=abs(xs-os);
      (1-gt(difference,1))*(1-gt(xs+os,9))
    }
  }
}

def u:ttt_outcome(board) {
  "Provide ttt outcome behavior in this MLPL module.";
  winner=u:ttt_winner(board);
  if winner {
    {status:"won",winner: winner}
  } else {
    if eq(reduce(:add,eq(board,0)),0) {
      {status:"draw",winner:0}
    } else {
      {status:"playing",winner:0}
    }
  }
}

def u:ttt_legal_moves_from(board,index,moves) {
  "Provide ttt legal moves from behavior in this MLPL module.";
  while lt(index,9) {
    moves=if eq(take(board,0,index),0) {
      concat(moves,index)
    } else {
      moves
    };
    index=index+1
  };
  moves
}

def u:ttt_legal_moves(board) {
  "Provide ttt legal moves behavior in this MLPL module.";
  u:ttt_legal_moves_from(board,0,fill([0],0))
}

def u:ttt_place(board,index,mark) {
  "Provide ttt place behavior in this MLPL module.";
  if (1-u:ttt_valid_board(board))+(1-eq(index,floor(index)))+lt(index,0)+gt(index,8)+(1-eq(abs(mark),1)) {
    err({kind:"tic_tac_toe_move",message:"invalid board, cell, or mark"})
  } else {
    if (1-eq(take(board,0,index),0))+(1-equal(u:ttt_outcome(board).status,"playing")) {
      err({kind:"tic_tac_toe_move",message:"cell is occupied or game is over"})
    } else {
      ok(scatter(board,index,mark))
    }
  }
}

def u:ttt_other(mark) {
  "Provide ttt other behavior in this MLPL module.";
  0-mark
}

def u:ttt_find_winning_move(board,mark) {
  "Provide ttt find winning move behavior in this MLPL module.";
  cell=0;
  found=-1;
  while lt(cell,9)*eq(found,-1) {
    if eq(take(board,0,cell),0) {
      found=if eq(u:ttt_winner(scatter(board,cell,mark)),mark) {
        cell
      } else {
        -1
      }
    };
    cell=cell+1
  };
  found
}

def u:ttt_live_move(board,ai_mark) {
  "Provide ttt live move behavior in this MLPL module.";
  win=u:ttt_find_winning_move(board,ai_mark);
  block=u:ttt_find_winning_move(board,u:ttt_other(ai_mark));
  if gt(win,-1) {
    ok(win)
  } else {
    if gt(block,-1) {
      ok(block)
    } else {
      if eq(take(board,0,4),0) {
        ok(4)
      } else {
        opposite=if eq(take(board,0,0),u:ttt_other(ai_mark))*eq(take(board,0,8),0) {
          8
        } else {
          if eq(take(board,0,8),u:ttt_other(ai_mark))*eq(take(board,0,0),0) {
            0
          } else {
            if eq(take(board,0,2),u:ttt_other(ai_mark))*eq(take(board,0,6),0) {
              6
            } else {
              if eq(take(board,0,6),u:ttt_other(ai_mark))*eq(take(board,0,2),0) {
                2
              } else {
                -1
              }
            }
          }
        };
        if gt(opposite,-1) {
          ok(opposite)
        } else {
          choices=[0,2,6,8,1,3,5,7];
          index=0;
          move=-1;
          while lt(index,8)*eq(move,-1) {
            candidate=take(choices,0,index);
            move=if eq(take(board,0,candidate),0) {
              candidate
            } else {
              -1
            };
            index=index+1
          };
          if gt(move,-1) {
            ok(move)
          } else {
            err({kind:"tic_tac_toe_move",message:"no legal live move"})
          }
        }
      }
    }
  }
}

def u:ttt_minimax_score(board,turn,ai_mark,depth,alpha,beta) {
  "Provide ttt minimax score behavior in this MLPL module.";
  outcome=u:ttt_outcome(board);
  if equal(outcome.status,"won") {
    if eq(outcome.winner,ai_mark) {
      10-depth
    } else {
      depth-10
    }
  } else {
    if equal(outcome.status,"draw") {
      0
    } else { u:ttt_minimax_scan(board,turn,ai_mark,0,0,-1,0,depth,alpha,beta).score }
  }
}

def u:ttt_minimax_scan(board,turn,ai_mark,index,best_score,best_move,found,depth,alpha,beta) {
  "Provide ttt minimax scan behavior in this MLPL module.";
  if eq(index,9)+gt(alpha,beta)+eq(alpha,beta) {
    {score: best_score,move: best_move}
  } else {
    if 1-eq(take(board,0,index),0) { u:ttt_minimax_scan(board,turn,ai_mark,index+1,best_score,best_move,found,depth,alpha,beta) } else {
      next=scatter(board,index,turn);
      score=u:ttt_minimax_score(next,u:ttt_other(turn),ai_mark,depth+1,alpha,beta);
      better=if 1-found {
        1
      } else {
        if eq(turn,ai_mark) {
          gt(score,best_score)
        } else {
          lt(score,best_score)
        }
      };
      chosen_score=if better {
        score
      } else {
        best_score
      };
      chosen_move=if better {
        index
      } else {
        best_move
      };
      next_alpha=if eq(turn,ai_mark)*gt(chosen_score,alpha) {
        chosen_score
      } else {
        alpha
      };
      next_beta=if (1-eq(turn,ai_mark))*lt(chosen_score,beta) {
        chosen_score
      } else {
        beta
      };
      u:ttt_minimax_scan(board,turn,ai_mark,index+1,chosen_score,chosen_move,1,depth,next_alpha,next_beta)
    }
  }
}

def u:ttt_best_move(board,ai_mark) {
  "Provide ttt best move behavior in this MLPL module.";
  if (1-u:ttt_valid_board(board))+(1-eq(abs(ai_mark),1))+(1-equal(u:ttt_outcome(board).status,"playing")) {
    err({kind:"tic_tac_toe_minimax",message:"invalid or terminal board"})
  } else {
    moves=u:ttt_legal_moves(board);
    count=tally(moves);
    if eq(count,9) {
      ok(0)
    } else {
      if eq(count,8) {
        if eq(take(board,0,4),0) {
          ok(4)
        } else {
          ok(0)
        }
      } else {
        ok(u:ttt_minimax_scan(board,ai_mark,ai_mark,0,0,-1,0,0,-100,100).move)
      }
    }
  }
}

def u:ttt_new_game(user_symbol,user_first) {
  "Provide ttt new game behavior in this MLPL module.";
  if (1-equal(user_symbol,"X"))*(1-equal(user_symbol,"O"))+(1-eq(user_first,0))*(1-eq(user_first,1)) {
    err({kind:"tic_tac_toe_setup",message:"choose X or O and first or second"})
  } else {
    user_mark=if equal(user_symbol,"X") {
      1
    } else {
      -1
    };
    ai_mark=0-user_mark;
    turn=if user_first {
      "user"
    } else {
      "ai"
    };
    ok({board: u:ttt_empty_board(),user_mark: user_mark,ai_mark: ai_mark,turn: turn,status:"playing",winner:0})
  }
}
