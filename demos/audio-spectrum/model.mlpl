# MLPL application semantics for demos audio spectrum model.
def u:audio_paths() {
  "Provide audio paths behavior in this MLPL module.";
  audio_files
}
def u:audio_frequencies() {
  "Provide audio frequencies behavior in this MLPL module.";
  [80,160,320,640,1250,2500,5000,10000]
}
def u:audio_channel_bands(samples,sample_rate) {
  "Provide audio channel bands behavior in this MLPL module.";
  n=if lt(tally(samples),64) {
    tally(samples)
  } else {
    64
  };
  values=compress(lt(range(tally(samples)),n),samples);
  frequencies=u:audio_frequencies();
  bands=zeros([8]);
  band=0;
  while lt(band,8) {
    frequency=take(frequencies,0,band);
    phase=range(n)*6.283185307179586*frequency/sample_rate;
    real=reduce(:add,values*cos(phase));
    imaginary=reduce(:add,values*sin(phase));
    magnitude=sqrt(real*real+imaginary*imaginary)/n;
    bands=scatter(bands,band,magnitude) ;
    band=band+1
  };
  bands
}
def u:audio_bands(left,right,sample_rate) {
  "Provide audio bands behavior in this MLPL module.";
  concat(u:audio_channel_bands(left,sample_rate),u:audio_channel_bands(right,sample_rate))
}
def u:audio_state(paths,selected,mode,playing,bands,sample_rate,start_frame,camera,revision,close_requested,viewport_width,viewport_height,press_x,press_y,dragged,message) {
  "Provide audio state behavior in this MLPL module.";
  {paths: paths,selected: selected,mode: mode,playing: playing,bands: bands,sample_rate: sample_rate,start_frame: start_frame,camera: camera,revision: revision,close_requested: close_requested,viewport_width: viewport_width,viewport_height: viewport_height,press_x: press_x,press_y: press_y,dragged: dragged,message: message}
}
def u:audio_defaults(paths) {
  "Provide audio defaults behavior in this MLPL module.";
  u:audio_state(paths,0,"menu",0,zeros([16]),1,0,u:n3d_camera_state([3,2,0],-0.55,0.35,22,1.0471975511965976,0.1,0,"none",0,0),0,0,900,700,0,0,0,"")
}
def u:audio_restate(state,selected,mode,playing,bands,sample_rate,start_frame,camera) {
  "Provide audio restate behavior in this MLPL module.";
  u:audio_state(state.paths,selected,mode,playing,bands,sample_rate,start_frame,camera,state.revision+1,state.close_requested,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.dragged,state.message)
}
def u:audio_selected_path(state) {
  "Provide audio selected path behavior in this MLPL module.";
  list_get(state.paths,state.selected)?
}
def u:audio_status(state) {
  "Provide audio status behavior in this MLPL module.";
  if 1-equal(state.message,"") {
    state.message
  } else {
    if equal(state.mode,"menu") {
      if equal(list_len(state.paths),0) {
        "NO MP3 OR OGG FILES FOUND"
      } else {
        str_concat("SELECTED FILE: ",u:audio_selected_path(state))
      }
    } else {
      seconds=state.start_frame/state.sample_rate;
      str_concat(if state.playing {
          "PLAYING "
        } else {
          "PAUSED "
        },str_concat(u:audio_selected_path(state),str_concat(" | TIME ",str_concat(to_json(floor(seconds*10)/10)?," S | AUDIO DEFAULT DEVICE"))))
    }
  }
}
def u:audio_menu_help(state) {
  "Provide audio menu help behavior in this MLPL module.";
  text="NATIVE 3D AUDIO SPECTRUM — CONFINED MP3/OGG PICKER\nUP/DOWN=SELECT | ENTER=OPEN AND PLAY | ESC=CLOSE\n";
  count=if lt(list_len(state.paths),12) {
    list_len(state.paths)
  } else {
    12
  };
  index=0;
  while lt(index,count) {
    marker=if equal(index,state.selected) {
      ">> "
    } else {
      "   "
    };
    text=str_concat(text,str_concat(marker,str_concat(list_get(state.paths,index)?,"\n")));
    index=index+1
  };
  text
}
def u:audio_help(state) {
  "Provide audio help behavior in this MLPL module.";
  if equal(state.mode,"menu") { u:audio_menu_help(state) } else {
    "NATIVE 3D AUDIO SPECTRUM — MLPL FREQUENCY ANALYSIS + SYNCHRONIZED DEFAULT-DEVICE AUDIO\nMIRRORED RADIAL FANS: LEFT/RIGHT CHANNELS | BASS BLUE INNER | MID GREEN | HIGH ORANGE OUTER\nAMPLITUDE EXTENDS SPOKES OUTWARD/UP | SPACE=PLAY/PAUSE | J/K=SEEK -/+5 S | M=MENU\nLEFT DRAG=ORBIT | SHIFT+LEFT/MIDDLE=PAN | WHEEL=ZOOM\n16 RETAINED SPOKES; PCM CHUNKS AND PLAYBACK QUEUE ARE BOUNDED"
  }
}
