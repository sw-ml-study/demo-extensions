# MLPL application semantics for demos audio spectrum live applet.
include "./scene.mlpl";
def u:audio_submit(state) {
  "Provide audio submit behavior in this MLPL module.";
  scene=u:audio_scene(state)?;
  port_send(port,{op: "set_scene",positions: scene.positions,edges: scene.edges,colors: scene.colors,thicknesses: scene.thicknesses,ids: scene.ids,rotation_y_speed: 0,revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:audio_help(state),status: u:audio_status(state)});
  ok(state)
}
def u:audio_submit_view(state) {
  "Provide audio submit view behavior in this MLPL module.";
  port_send(port,{op: "set_view",revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:audio_help(state),status: u:audio_status(state)});
  ok(state)
}
def u:audio_on_key(event,state) {
  "Provide audio on key behavior in this MLPL module.";
  if equal(state.mode,"menu") {
    selected=state.selected;
    if equal(event.key,"arrow_down")*lt(selected+1,list_len(state.paths)) {
      selected=selected+1
    };
    if equal(event.key,"arrow_up")*gt(selected,0) {
      selected=selected-1
    };
    next=u:audio_restate(state,selected,state.mode,state.playing,state.bands,state.sample_rate,state.start_frame,state.camera);
    if equal(event.key,"enter")*gt(list_len(state.paths),0) {
      next=u:audio_restate(next,next.selected,"spectrum",1,next.bands,next.sample_rate,0,next.camera);
      port_send(port,{op: "audio_open",path: u:audio_selected_path(next)})
    };
    u:audio_submit_view(next)?;
    next
  } else {
    playing=if equal(event.key,"space") {
      1-state.playing
    } else {
      state.playing
    };
    next=u:audio_restate(state,state.selected,state.mode,playing,state.bands,state.sample_rate,state.start_frame,state.camera);
    if equal(event.key,"space") {
      port_send(port,{op: "audio_play",playing: playing})
    };
    if equal(event.key,"j") {
      target=if lt(state.start_frame/state.sample_rate,5) {
        0
      } else {
        state.start_frame/state.sample_rate-5
      };
      port_send(port,{op: "audio_seek",seconds: target})
    };
    if equal(event.key,"k") {
      port_send(port,{op: "audio_seek",seconds: state.start_frame/state.sample_rate+5})
    };
    if equal(event.key,"m") {
      next=u:audio_restate(next,next.selected,"menu",0,zeros([16]),1,0,next.camera);
      port_send(port,{op: "audio_play",playing: 0})
    };
    u:audio_submit_view(next)?;
    next
  }
}
def u:audio_on_chunk(event,state) {
  "Provide audio on chunk behavior in this MLPL module.";
  next=if equal(state.mode,"spectrum") { u:audio_restate(state,state.selected,state.mode,state.playing,u:audio_bands(event.left,event.right,event.sample_rate_hz),event.sample_rate_hz,event.start_frame,state.camera) } else {
    state
  };
  if equal(state.mode,"spectrum") {
    port_send(port,u:audio_patch(state,next)?);
    u:audio_submit_view(next)?
  };
  port_send(port,{op: "audio_ack"});
  next
}
def u:audio_on_event(event,state) {
  "Provide audio on event behavior in this MLPL module.";
  if equal(event.kind,"key") { u:audio_on_key(event,state) } else {
    if equal(event.kind,"audio_chunk") { u:audio_on_chunk(event,state) } else {
      if equal(event.kind,"audio_error") {
        next=u:audio_state(state.paths,state.selected,"menu",0,state.bands,state.sample_rate,state.start_frame,state.camera,state.revision,state.close_requested,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.dragged,event.message);
        u:audio_submit_view(next)?;
        next
      } else {
        if equal(event.kind,"close") { u:audio_state(state.paths,state.selected,state.mode,0,state.bands,state.sample_rate,state.start_frame,state.camera,state.revision,1,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.dragged,state.message) } else {
          if equal(event.kind,"wheel")+equal(event.kind,"pointer_down")+equal(event.kind,"pointer_move")+equal(event.kind,"pointer_up") {
            camera=u:n3d_camera_reduce(state.camera,event);
            next=u:audio_state(state.paths,state.selected,state.mode,state.playing,state.bands,state.sample_rate,state.start_frame,camera,state.revision,state.close_requested,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.dragged,state.message);
            u:audio_submit_view(next)?;
            next
          } else {
            state
          }
        }
      }
    }
  }
}
def u:audio_resync(event,state) {
  "Resend a complete spectrum scene only after an explicit renderer resync request.";
  u:audio_submit(state)?;
  state
}
paths=u:audio_paths();
state=u:audio_defaults(paths);
u:audio_submit(state)?;
on(port,"key",:u:audio_on_event);
on(port,"audio_chunk",:u:audio_on_event);
on(port,"audio_error",:u:audio_on_event);
on(port,"wheel",:u:audio_on_event);
on(port,"pointer_down",:u:audio_on_event);
on(port,"pointer_move",:u:audio_on_event);
on(port,"pointer_up",:u:audio_on_event);
on(port,"close",:u:audio_on_event);
on(port,"resync",:u:audio_resync);
run(port,state)
