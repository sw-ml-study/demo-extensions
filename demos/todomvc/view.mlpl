# Server-rendered, escaped TodoMVC HTML view.
def u:todo_render_item(state,index) {
  "Render one visible todo list item with escaped user text.";
  id=to_json(take(state.ids,0,index))?;
  title=u:web_html_escape(u:todo_title_at(state.titles,index));
  class=if eq(take(state.completed,0,index),1) {
    "completed"
  } else {
    "active"
  };
  checked=if eq(take(state.completed,0,index),1) {
    " checked"
  } else {
    ""
  };
  prefix=str_concat("<li class=\"",str_concat(class,str_concat("\" data-id=\"",str_concat(id,"\">"))));
  toggle=str_concat("<form class=\"toggle-form\" method=\"post\" action=\"/todos/",str_concat(id,str_concat("/toggle\"><button class=\"toggle\" type=\"submit\" aria-label=\"Toggle todo\">",str_concat(if equal(checked,"") {
            "[ ]"
          } else {
            "[x]"
          },"</button></form>"))));
  edit=str_concat("<form class=\"edit-form\" method=\"post\" action=\"/todos/",str_concat(id,str_concat("/edit\"><input name=\"title\" value=\"",str_concat(title,"\" aria-label=\"Edit todo\"><button type=\"submit\">Save</button></form>"))));
  remove=str_concat("<form class=\"delete-form\" method=\"post\" action=\"/todos/",str_concat(id,"/delete\"><button class=\"destroy\" type=\"submit\" aria-label=\"Delete todo\">Delete</button></form>"));
  html=str_concat(prefix,str_concat(toggle,str_concat(edit,str_concat(remove,"</li>"))));
  ok(html)
}

def u:todo_render(state,filter) {
  "Render the standard TodoMVC shell, filtered list, count, and clear action.";
  visible=u:todo_visible(state,filter);
  items="";
  index=0;
  while lt(index,state.capacity) {
    if eq(take(visible,0,index),1) {
      items=str_concat(items,u:todo_render_item(state,index)?)
    };
    index=index+1
  };
  remaining=to_json(u:todo_remaining(state))?;
  head="<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>MLPL TodoMVC</title><style>body{font:16px system-ui;background:#f5f5f5;color:#222}.todoapp{max-width:720px;margin:3rem auto;background:white;padding:2rem;box-shadow:0 2px 14px #bbb}h1{font-size:4rem;text-align:center;color:#b83f45}.new-todo{font-size:1.2rem;padding:.7rem;width:70%}button{margin:.25rem;padding:.55rem}.todo-list{list-style:none;padding:0}.todo-list li{display:flex;gap:.5rem;align-items:center;border-bottom:1px solid #ddd;padding:.5rem}.edit-form{display:flex;flex:1;gap:.4rem}.edit-form input{flex:1;padding:.5rem}.completed .edit-form input{text-decoration:line-through;color:#777}nav{display:inline-block;margin:0 1rem}</style></head><body><main class=\"todoapp\"><header><h1>todos</h1><form method=\"post\" action=\"/todos\"><input name=\"title\" class=\"new-todo\" placeholder=\"What needs to be done?\" maxlength=\"200\" required autofocus><button type=\"submit\">Add</button></form></header><section class=\"main\"><ul class=\"todo-list\">";
  foot=str_concat("</ul></section><footer><span class=\"todo-count\"><strong>",str_concat(remaining,"</strong> items left</span><nav><a href=\"/?filter=all\">All</a> <a href=\"/?filter=active\">Active</a> <a href=\"/?filter=completed\">Completed</a></nav><form method=\"post\" action=\"/todos/clear\"><button>Clear completed</button></form></footer></main></body></html>"));
  ok(str_concat(head,str_concat(items,foot)))
}
