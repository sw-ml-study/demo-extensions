# Server-rendered, escaped TodoMVC HTML view.
def u:todo_render_item(state,index) {
  "Render one visible todo list item with escaped user text.";
  id=to_json(take(state.ids,0,index))?;
  title=u:web_html_escape(u:todo_title_at(state.titles,index));
  class=if eq(take(state.completed,0,index),1) {
    "completed"
  } else {
    "active"
  };
  checked=if eq(take(state.completed,0,index),1) {
    " checked"
  } else {
    ""
  };
  prefix=str_concat("<li class=\"",str_concat(class,str_concat("\" data-id=\"",str_concat(id,"\">"))));
  toggle=str_concat("<form class=\"toggle-form\" method=\"post\" action=\"/todos/",str_concat(id,str_concat("/toggle\"><button class=\"toggle\" type=\"submit\" aria-label=\"Toggle todo\">",str_concat(if equal(checked,"") {
            "[ ]"
          } else {
            "[x]"
          },"</button></form>"))));
  edit=str_concat("<form class=\"edit-form\" method=\"post\" action=\"/todos/",str_concat(id,str_concat("/edit\"><input name=\"title\" value=\"",str_concat(title,"\" aria-label=\"Edit todo\"><button type=\"submit\">Save</button></form>"))));
  remove=str_concat("<form class=\"delete-form\" method=\"post\" action=\"/todos/",str_concat(id,"/delete\"><button class=\"destroy\" type=\"submit\" aria-label=\"Delete todo\">Delete</button></form>"));
  html=str_concat(prefix,str_concat(toggle,str_concat(edit,str_concat(remove,"</li>"))));
  ok(html)
}

def u:todo_render(state,filter) {
  "Render the standard TodoMVC shell, filtered list, count, and clear action.";
  visible=u:todo_visible(state,filter);
  items="";
  index=0;
  while lt(index,state.capacity) {
    if eq(take(visible,0,index),1) {
      items=str_concat(items,u:todo_render_item(state,index)?)
    };
    index=index+1
  };
  remaining=to_json(u:todo_remaining(state))?;
  head="<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>sw-MLPL Demo: TodoMVC</title><style>body{font:16px system-ui;background:#f5f5f5;color:#222;margin:0}.todoapp{max-width:720px;margin:3rem auto 1rem;background:white;padding:2rem;box-shadow:0 2px 14px #bbb}h1{margin:0;text-align:center;color:#555;font-size:1.1rem;letter-spacing:.08em}h2{font-size:4rem;text-align:center;color:#b83f45;margin:.15rem 0 1.5rem}.new-todo{font-size:1.2rem;padding:.7rem;width:70%}button{margin:.25rem;padding:.55rem}.todo-list{list-style:none;padding:0}.todo-list li{display:flex;gap:.5rem;align-items:center;border-bottom:1px solid #ddd;padding:.5rem}.edit-form{display:flex;flex:1;gap:.4rem}.edit-form input{flex:1;padding:.5rem}.completed .edit-form input{text-decoration:line-through;color:#777}nav{display:inline-block;margin:0 1rem}.github-corner{position:absolute;right:0;top:0;color:#fff}.github-corner svg{fill:#24292f}.github-corner:hover svg{fill:#b83f45}.app-footer{text-align:center;color:#666;font-size:.85rem;margin:1rem}.app-footer a{color:#555}</style></head><body><a class=\"github-corner\" href=\"https://github.com/sw-ml-study/demo-extensions\" aria-label=\"View demo-extensions on GitHub\"><svg width=\"80\" height=\"80\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M8 0C3.58 0 0 3.64 0 8.13c0 3.59 2.29 6.64 5.47 7.71.4.08.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.38-2.53-.5-2.69-.96-.09-.23-.48-.96-.82-1.15-.28-.15-.68-.52-.01-.53.63-.01 1.08.59 1.23.83.72 1.23 1.87.88 2.33.67.07-.53.28-.88.51-1.08-1.78-.21-3.64-.91-3.64-4.02 0-.89.31-1.62.82-2.19-.08-.2-.36-1.04.08-2.16 0 0 .67-.22 2.2.84A7.46 7.46 0 0 1 8 3.97c.68 0 1.36.09 2 .27 1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.96.08 2.16.51.57.82 1.3.82 2.19 0 3.12-1.87 3.81-3.65 4.02.29.25.54.74.54 1.5 0 1.08-.01 1.95-.01 2.22 0 .21.15.46.55.38A8.14 8.14 0 0 0 16 8.13C16 3.64 12.42 0 8 0Z\"/></svg></a><main class=\"todoapp\"><header><h1>sw-MLPL Demo</h1><h2>TodoMVC</h2><form method=\"post\" action=\"/todos\"><input name=\"title\" class=\"new-todo\" placeholder=\"What needs to be done?\" maxlength=\"200\" required autofocus><button type=\"submit\">Add</button></form></header><section class=\"main\"><ul class=\"todo-list\">";
  foot=str_concat("</ul></section><footer><span class=\"todo-count\"><strong>",str_concat(remaining,"</strong> items left</span><nav><a href=\"/?filter=all\">All</a> <a href=\"/?filter=active\">Active</a> <a href=\"/?filter=completed\">Completed</a></nav><form method=\"post\" action=\"/todos/clear\"><button>Clear completed</button></form></footer></main><footer class=\"app-footer\">Copyright &copy; 2026 Michael A Wright &middot; <a href=\"https://github.com/sw-ml-study/demo-extensions/blob/main/LICENSE\">MIT License</a></footer></body></html>"));
  ok(str_concat(head,str_concat(items,foot)))
}
