# Persistent browser TodoMVC server composed entirely from generic native providers.
include "../../extensions/http-server/module.mlpl";
include "../../extensions/sqlite/module.mlpl";
include "../../lib/web/encoding.mlpl";
include "../../lib/web/router.mlpl";
include "../../lib/web/http.mlpl";
include "model.mlpl";
include "view.mlpl";
include "app.mlpl";

web_library=list_get(args(),0)?;
sqlite_library=list_get(args(),1)?;
database_root=list_get(args(),2)?;
database_path=list_get(args(),3)?;
port=to_number(list_get(args(),4)?)?;
load_extension(web_library);
load_extension(sqlite_library);
connection=_sqlite:open({root: database_root,path: database_path,busy_timeout_ms: 5000,max_rows: 8,max_result_bytes: 262144});
_sqlite:execute(connection,u:todo_schema_plan().sql,u:sqlite_params0());
origin=str_concat("http://127.0.0.1:",to_string(port));
policy=str_concat("version = 1\n[limits]\nmax_header_bytes = 16384\nmax_body_bytes = 1048576\n[cors]\nallowed_origins = [\"",str_concat(origin,"\"]\nallowed_methods = [\"GET\", \"POST\"]\n[token]\nsource = \"none\"\nverification = \"none\"\n[authorization]\nowner = \"mlpl\"\n"));
server=_web:listen({address: "127.0.0.1",port: port,max_pending: 16},policy);
address=_web:local_address(server);
print(str_concat("MLPL TodoMVC listening at http://",str_concat(address,"/")));
while 1 {
  request=_web:next_request(server,1000);
  if equal(type_of(request),"record") {
    rows=_sqlite:query(connection,u:todo_select_plan().sql,u:sqlite_params0());
    state=u:todo_from_query(rows)?;
    result=u:todo_dispatch(state,request)?;
    if equal(request.method,"POST") {
      if 1-eq(str_len(result.db_plan.sql),0) {
        _sqlite:execute(connection,result.db_plan.sql,result.db_plan.params)
      };
      response=u:web_redirect_response("/")?
    } else {
      response=result.response
    };
    _web:respond(server,request.id,response)
  }
}
