include "./model.mlpl";
include "../../lib/native3d/geometry.mlpl";

def u:atlas_lines() { {positions: fill([0],0),starts: fill([0],0),ends: fill([0],0),edges: fill([0],0),colors: fill([0],0),thicknesses: fill([0],0),ids: fill([0],0),count: 0} }
def u:atlas_add(state,start,end,color,thickness,id) { vertex=state.count*2; {positions: concat(state.positions,concat(start,end)),starts: concat(state.starts,start),ends: concat(state.ends,end),edges: concat(state.edges,[vertex,vertex+1]),colors: concat(state.colors,color),thicknesses: concat(state.thicknesses,thickness),ids: concat(state.ids,id),count: state.count+1} }
def u:atlas_add_box(state,x,y,z,width,height,depth,color,thickness,id) { x0=x-width/2; x1=x+width/2; y0=y-height/2; y1=y+height/2; z0=z-depth/2; z1=z+depth/2; p0=[x0,y0,z0]; p1=[x1,y0,z0]; p2=[x1,y0,z1]; p3=[x0,y0,z1]; p4=[x0,y1,z0]; p5=[x1,y1,z0]; p6=[x1,y1,z1]; p7=[x0,y1,z1]; state=u:atlas_add(state,p0,p1,color,thickness,id); state=u:atlas_add(state,p1,p2,color,thickness,id+1); state=u:atlas_add(state,p2,p3,color,thickness,id+2); state=u:atlas_add(state,p3,p0,color,thickness,id+3); state=u:atlas_add(state,p4,p5,color,thickness,id+4); state=u:atlas_add(state,p5,p6,color,thickness,id+5); state=u:atlas_add(state,p6,p7,color,thickness,id+6); state=u:atlas_add(state,p7,p4,color,thickness,id+7); state=u:atlas_add(state,p0,p4,color,thickness,id+8); state=u:atlas_add(state,p1,p5,color,thickness,id+9); state=u:atlas_add(state,p2,p6,color,thickness,id+10); u:atlas_add(state,p3,p7,color,thickness,id+11) }
def u:atlas_add_ground_rect(state,x,z,width,depth,color,id) { x0=x-width/2; x1=x+width/2; z0=z-depth/2; z1=z+depth/2; state=u:atlas_add(state,[x0,0,z0],[x1,0,z0],color,1,id); state=u:atlas_add(state,[x1,0,z0],[x1,0,z1],color,1,id+1); state=u:atlas_add(state,[x1,0,z1],[x0,0,z1],color,1,id+2); u:atlas_add(state,[x0,0,z1],[x0,0,z0],color,1,id+3) }
def u:atlas_add_districts(state) { state=u:atlas_add_ground_rect(state,2,0,6,2,[0.2,0.55,1,1],0); u:atlas_add_ground_rect(state,3,4,8,2,[1,0.5,0.2,1],12) }
def u:atlas_building_color(state,index) { if eq(index,state.selected) { [1,0.9,0.15,1] } else { if eq(take(state.city.scene_columns.format_codes,0,index),0) { [0.2,0.65,1,1] } else { [1,0.45,0.2,1] } } }
def u:atlas_city_scene(state) { lines=u:atlas_add_districts(u:atlas_lines()); index=0; while lt(index,state.city.tensor_count) { if u:atlas_city_visible(state,index) { x=take(state.city.scene_columns.x,0,index); z=take(state.city.scene_columns.z,0,index); width=take(state.city.scene_columns.widths,0,index); depth=take(state.city.scene_columns.depths,0,index); bytes=take(state.city.scene_columns.byte_counts,0,index); full_height=u:atlas_city_log_height(bytes); height=if state.lod { full_height } else { 0.2 }; y=height/2; thickness=if eq(index,state.selected) { 4 } else { 2 }; lines=u:atlas_add_box(lines,x,y,z,width,height,depth,u:atlas_building_color(state,index),thickness,100+index*12) }; index=index+1 }; style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids}; u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0) }
def u:atlas_scene_line_index(scene,id) { found=-1; index=0; while lt(index,tally(scene.ids)) { if eq(take(scene.ids,0,index),id) { found=index }; index=index+1 }; found }
def u:atlas_patch_add_line(patch,scene,index) { edge=take(scene.edges,0,index); start=take(scene.positions,0,take(edge,0,0)); end=take(scene.positions,0,take(edge,0,1)); {starts: concat(patch.starts,start),ends: concat(patch.ends,end),colors: concat(patch.colors,take(scene.colors,0,index)),thicknesses: concat(patch.thicknesses,take(scene.thicknesses,0,index)),ids: concat(patch.ids,take(scene.ids,0,index)),removes: patch.removes,count: patch.count+1} }
def u:atlas_city_scene_patch(before,after) { old=u:atlas_city_scene(before)?; new=u:atlas_city_scene(after)?; patch={starts: fill([0],0),ends: fill([0],0),colors: fill([0],0),thicknesses: fill([0],0),ids: fill([0],0),removes: fill([0],0),count: 0}; index=0; while lt(index,tally(new.ids)) { id=take(new.ids,0,index); prior=u:atlas_scene_line_index(old,id); changed=lt(prior,0); if 1-changed { changed=(1-equal(take(new.colors,0,index),take(old.colors,0,prior)))+(1-eq(take(new.thicknesses,0,index),take(old.thicknesses,0,prior)))+(1-equal(take(new.positions,0,take(take(new.edges,0,index),0,0)),take(old.positions,0,take(take(old.edges,0,prior),0,0))))+(1-equal(take(new.positions,0,take(take(new.edges,0,index),0,1)),take(old.positions,0,take(take(old.edges,0,prior),0,1)))) }; if changed { patch=u:atlas_patch_add_line(patch,new,index) }; index=index+1 }; index=0; while lt(index,tally(old.ids)) { id=take(old.ids,0,index); if lt(u:atlas_scene_line_index(new,id),0) { patch={starts: patch.starts,ends: patch.ends,colors: patch.colors,thicknesses: patch.thicknesses,ids: patch.ids,removes: concat(patch.removes,id),count: patch.count} }; index=index+1 }; ok({op: "patch_scene",base_revision: before.revision,target_revision: after.revision,ids: patch.ids,starts: reshape(patch.starts,[patch.count,3]),ends: reshape(patch.ends,[patch.count,3]),colors: reshape(patch.colors,[patch.count,4]),thicknesses: patch.thicknesses,remove_ids: patch.removes}) }
