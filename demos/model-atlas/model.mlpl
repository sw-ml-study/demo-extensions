include "../../fixtures/model-atlas/tensor_city_derived.mlpl";
include "../../lib/model-atlas/interchange.mlpl";
include "../../lib/native3d/camera.mlpl";

def u:atlas_city_budgets() { {max_objects: 12,max_tensors: 7,max_label_bytes: 64,max_id_bytes: 128,max_hierarchy_depth: 4,max_coordinate: 40,max_parameters: 1000000,max_elements: 4096,max_iterations: 64,max_output_bytes: 32768,max_json_depth: 8,max_json_elements: 4096} }
def u:atlas_city_state(city,camera,viewport_width,viewport_height,selected,filter,lod,revision,close_requested,press_x,press_y,gesture_dragged) { {city: city,camera: camera,viewport_width: viewport_width,viewport_height: viewport_height,selected: selected,filter: filter,lod: lod,revision: revision,close_requested: close_requested,press_x: press_x,press_y: press_y,gesture_dragged: gesture_dragged} }
def u:atlas_city_defaults() { city=u:atlas_interchange(u:atlas_tensor_city_fixture(),u:atlas_city_budgets())?; camera=u:n3d_camera_state([3,5,2],-0.65,0.45,38,1.0471975511965976,0.1,0,"none",0,0); u:atlas_city_state(city,camera,800,600,-1,0,1,0,0,0,0,0) }
def u:atlas_city_restate(state,camera,selected,filter,lod,close_requested,press_x,press_y,dragged) { visual=(1-equal(camera,state.camera))+(1-eq(selected,state.selected))+(1-eq(filter,state.filter))+(1-eq(lod,state.lod)); visual=if visual { 1 } else { 0 }; u:atlas_city_state(state.city,camera,state.viewport_width,state.viewport_height,selected,filter,lod,state.revision+visual,close_requested,press_x,press_y,dragged) }
def u:atlas_city_text(a,b) { decode_bytes(concat(tokenize_bytes(a),tokenize_bytes(b))) }
def u:atlas_city_selected_name(state) { if lt(state.selected,0) { "none" } else { u:atlas_text_row(state.city.scene_columns.name_bytes,state.city.scene_columns.name_lengths,state.selected,state.city.bounds.max_label_bytes) } }
def u:atlas_city_filter_name(filter) { if eq(filter,1) { "SAFETENSORS" } else { if eq(filter,2) { "GGUF" } else { "ALL" } } }
def u:atlas_city_help(state) { first=u:atlas_city_text("MODEL ATLAS  7 tensors  ",u:atlas_city_filter_name(state.filter)); first=u:atlas_city_text(first,if state.lod { "  LOD BUILDINGS" } else { "  LOD FOOTPRINTS" }); selected=u:atlas_city_text("\nSELECTED: ",u:atlas_city_selected_name(state)); u:atlas_city_text(u:atlas_city_text(first,"\nCLICK SELECT  LEFT DRAG ORBIT  SHIFT+LEFT/MIDDLE PAN  WHEEL ZOOM\nA ALL  S SAFETENSORS  G GGUF  L LOD  R RESET  ESC CLOSE"),selected) }
def u:atlas_city_select(state,index) { u:atlas_city_restate(state,state.camera,index,state.filter,state.lod,state.close_requested,state.press_x,state.press_y,state.gesture_dragged) }
def u:atlas_city_key(state,key) { if equal(key,"a") { u:atlas_city_restate(state,state.camera,-1,0,state.lod,state.close_requested,state.press_x,state.press_y,0) } else { if equal(key,"s") { u:atlas_city_restate(state,state.camera,-1,1,state.lod,state.close_requested,state.press_x,state.press_y,0) } else { if equal(key,"g") { u:atlas_city_restate(state,state.camera,-1,2,state.lod,state.close_requested,state.press_x,state.press_y,0) } else { if equal(key,"l") { u:atlas_city_restate(state,state.camera,state.selected,state.filter,1-state.lod,state.close_requested,state.press_x,state.press_y,0) } else { if equal(key,"r") { fresh=u:atlas_city_defaults(); u:atlas_city_state(state.city,fresh.camera,state.viewport_width,state.viewport_height,-1,0,1,state.revision+1,state.close_requested,0,0,0) } else { state } } } } } }
def u:atlas_city_visible(state,index) { format=take(state.city.scene_columns.format_codes,0,index); eq(state.filter,0)+eq(state.filter,format+1) }
