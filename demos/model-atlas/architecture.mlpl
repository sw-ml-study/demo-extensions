# Architecture metadata is authoritative; tensor-name roles are visibly heuristic.
def u:atlas_authoritative_architecture(city) { city.provenance.sources.gguf.general_architecture }
def u:atlas_inferred_role(name) {
  role="UNKNOWN";
  if u:atlas_text_contains(name,"embed_tokens") { role="EMBEDDING" };
  if u:atlas_text_contains(name,"self_attn.q_proj") { role="ATTENTION Q" };
  if u:atlas_text_contains(name,"self_attn.k_proj") { role="ATTENTION K" };
  if u:atlas_text_contains(name,"self_attn.v_proj") { role="ATTENTION V" };
  if u:atlas_text_contains(name,"self_attn.o_proj") { role="ATTENTION OUTPUT" };
  if u:atlas_text_contains(name,".norm.")+u:atlas_text_contains(name,"_norm.") { role="NORMALIZATION" };
  if u:atlas_text_contains(name,"block_sparse_moe.gate") { role="MOE GATE" };
  if u:atlas_text_contains(name,"shared_expert") { role="MOE SHARED EXPERT" };
  if u:atlas_text_contains(name,".experts.") { role="MOE EXPERT" };
  if u:atlas_text_contains(name,".mlp.up_proj")+u:atlas_text_contains(name,".mlp.down_proj")+u:atlas_text_contains(name,".mlp.gate_proj") { role="FEED-FORWARD" };
  if u:atlas_text_contains(name,".ssm.in_proj")+u:atlas_text_contains(name,".ssm.out_proj") { role="MAMBA/SSM PROJECTION" };
  if u:atlas_text_contains(name,".ssm.conv1d") { role="MAMBA/SSM CONV" };
  if u:atlas_text_contains(name,".ssm.A_log")+u:atlas_text_contains(name,".ssm.D") { role="MAMBA/SSM STATE" };
  if u:atlas_text_contains(name,"lm_head")+u:atlas_text_contains(name,"output.weight") { role="OUTPUT HEAD" };
  role
}
