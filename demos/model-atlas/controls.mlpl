include "./scene.mlpl";

def u:atlas_city_pick(state,event) { ray=u:n3d_pick_ray(state.camera,{viewport:{width: state.viewport_width,height: state.viewport_height},xy:[event.x,event.y]})?; hit=u:n3d_ray_plane_hit(ray,[0,0,0],[0,1,0])?; if 1-hit.hit { ok(-1) } else { x=take(hit.point,0,0); z=take(hit.point,0,2); found=-1; index=0; while lt(index,state.city.tensor_count) { if u:atlas_city_visible(state,index) { cx=take(state.city.scene_columns.x,0,index); cz=take(state.city.scene_columns.z,0,index); width=take(state.city.scene_columns.widths,0,index); depth=take(state.city.scene_columns.depths,0,index); if lt(abs(x-cx),width/2+0.15)*lt(abs(z-cz),depth/2+0.15) { found=index } }; index=index+1 }; ok(found) } }
def u:atlas_city_gesture(state,camera,press_x,press_y,dragged) { u:atlas_city_restate(state,camera,state.selected,state.filter,state.lod,state.close_requested,press_x,press_y,dragged) }
def u:atlas_city_reduce(state,event) { if equal(event.kind,"key") { u:atlas_city_key(state,event.key) } else { if equal(event.kind,"pointer_down") { camera=u:n3d_camera_reduce(state.camera,event); u:atlas_city_gesture(state,camera,event.x,event.y,0) } else { if equal(event.kind,"pointer_move") { if state.camera.dragging { distance2=(event.x-state.press_x)*(event.x-state.press_x)+(event.y-state.press_y)*(event.y-state.press_y); dragged=if state.gesture_dragged+gt(distance2,16) { 1 } else { 0 }; camera=if dragged { u:n3d_camera_reduce(state.camera,event) } else { state.camera }; u:atlas_city_gesture(state,camera,state.press_x,state.press_y,dragged) } else { state } } else { if equal(event.kind,"pointer_up") { camera=u:n3d_camera_reduce(state.camera,event); released=u:atlas_city_gesture(state,camera,state.press_x,state.press_y,0); if equal(event.button,"left")*(1-state.gesture_dragged) { cell=u:atlas_city_pick(released,event)?; u:atlas_city_select(released,cell) } else { released } } else { if equal(event.kind,"wheel") { camera=u:n3d_camera_reduce(state.camera,event); u:atlas_city_gesture(state,camera,state.press_x,state.press_y,state.gesture_dragged) } else { if equal(event.kind,"resize") { u:atlas_city_state(state.city,state.camera,u:n3d_clamp(event.width,1,8192),u:n3d_clamp(event.height,1,8192),state.selected,state.filter,state.lod,state.revision,state.close_requested,state.press_x,state.press_y,state.gesture_dragged) } else { if equal(event.kind,"close") { u:atlas_city_state(state.city,state.camera,state.viewport_width,state.viewport_height,state.selected,state.filter,state.lod,state.revision,1,state.press_x,state.press_y,0) } else { state } } } } } } } }
