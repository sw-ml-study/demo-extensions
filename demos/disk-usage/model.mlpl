# MLPL application semantics for demos disk usage model.
def u:du_state(snapshot,breadcrumb,selected,threshold,camera,revision,close_requested,viewport_width,viewport_height,press_x,press_y,dragged,children) {
  "Provide du state behavior in this MLPL module.";
  {snapshot: snapshot,breadcrumb: breadcrumb,selected: selected,threshold: threshold,camera: camera,revision: revision,close_requested: close_requested,viewport_width: viewport_width,viewport_height: viewport_height,press_x: press_x,press_y: press_y,dragged: dragged,children: children}
}
def u:du_uncached(snapshot,breadcrumb,selected,threshold,camera,revision,close_requested,viewport_width,viewport_height,press_x,press_y,dragged) {
  "Provide du uncached behavior in this MLPL module.";
  empty={indices: fill([0],0),totals: fill([0],0),count: 0,count_text: "0",capacity: 0};
  u:du_state(snapshot,breadcrumb,selected,threshold,camera,revision,close_requested,viewport_width,viewport_height,press_x,press_y,dragged,empty)
}
def u:du_defaults(snapshot) {
  "Provide du defaults behavior in this MLPL module.";
  base=u:du_uncached(snapshot,"",0,0,u:n3d_camera_state([4.5,2,4.5],-0.65,0.55,24,1.0471975511965976,0.1,0,"none",0,0),0,0,900,700,0,0,0);
  u:du_state(snapshot,"",0,0,base.camera,0,0,900,700,0,0,0,u:du_compute_children(base))
}
def u:du_restate(state,breadcrumb,selected,threshold,camera) {
  "Provide du restate behavior in this MLPL module.";
  unchanged=equal(breadcrumb,state.breadcrumb)*equal(threshold,state.threshold);
  base=u:du_uncached(state.snapshot,breadcrumb,selected,threshold,camera,state.revision+1,state.close_requested,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.dragged);
  children=if unchanged {
    state.children
  } else { u:du_compute_children(base) };
  u:du_state(state.snapshot,breadcrumb,selected,threshold,camera,state.revision+1,state.close_requested,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.dragged,children)
}
def u:du_viewstate(state,camera,press_x,press_y,dragged) {
  "Provide du viewstate behavior in this MLPL module.";
  u:du_state(state.snapshot,state.breadcrumb,state.selected,state.threshold,camera,state.revision,state.close_requested,state.viewport_width,state.viewport_height,press_x,press_y,dragged,state.children)
}
def u:du_under(path,breadcrumb) {
  "Provide du under behavior in this MLPL module.";
  if equal(breadcrumb,"") {
    1
  } else {
    equal(path,breadcrumb)+equal(str_slice(path,0,str_len(breadcrumb)+1),str_concat(breadcrumb,"/"))
  }
}
def u:du_child_path(path,breadcrumb) {
  "Provide du child path behavior in this MLPL module.";
  if (1-u:du_under(path,breadcrumb))+equal(path,breadcrumb) {
    ""
  } else {
    remainder=if equal(breadcrumb,"") {
      path
    } else {
      str_slice(path,str_len(breadcrumb)+1,str_len(path))
    };
    parts=str_split(remainder,"/");
    child=list_get(parts,0)?;
    if equal(breadcrumb,"") {
      child
    } else {
      str_concat(breadcrumb,str_concat("/",child))
    }
  }
}
def u:du_stable_id(state,path) {
  "Provide du stable id behavior in this MLPL module.";
  index=0;
  found=-1;
  while lt(index,list_len(state.snapshot.paths))*lt(found,0) {
    if equal(list_get(state.snapshot.paths,index)?,path) {
      found=index
    };
    index=index+1
  };
  found
}
def u:du_children_nonempty(state) {
  "Provide du children nonempty behavior in this MLPL module.";
  path_count=list_len(state.snapshot.paths);
  capacity=if lt(path_count,16) {
    16
  } else {
    path_count
  };
  count=0;
  indices=zeros([capacity]);
  totals=zeros([capacity]);
  index=0;
  while lt(index,path_count) {
    path=list_get(state.snapshot.paths,index)?;
    child=u:du_child_path(path,state.breadcrumb);
    if 1-equal(child,"") {
      slot=0;
      found=-1;
      while lt(slot,count)*lt(found,0) {
        representative=take(indices,0,slot);
        if equal(u:du_child_path(list_get(state.snapshot.paths,representative)?,state.breadcrumb),child) {
          found=slot
        };
        slot=slot+1
      };
      if lt(found,0) {
        found=count;
        indices=scatter(indices,count,index);
        count=count+1
      };
      totals=scatter(totals,found,take(totals,0,found)+take(state.snapshot.bytes,0,index))
    };
    index=index+1
  };
  i=0;
  while lt(i,count) {
    j=i+1;
    while lt(j,count) {
      left_path=u:du_child_path(list_get(state.snapshot.paths,take(indices,0,i))?,state.breadcrumb);
      right_path=u:du_child_path(list_get(state.snapshot.paths,take(indices,0,j))?,state.breadcrumb);
      left_dir=u:du_child_is_dir(state,left_path);
      right_dir=u:du_child_is_dir(state,right_path);
      swap=right_dir*(1-left_dir)+equal(right_dir,left_dir)*gt(take(totals,0,j),take(totals,0,i));
      if swap {
        a=take(totals,0,i);
        totals=scatter(totals,i,take(totals,0,j));
        totals=scatter(totals,j,a);
        a=take(indices,0,i);
        indices=scatter(indices,i,take(indices,0,j));
        indices=scatter(indices,j,a)
      };
      j=j+1
    };
    i=i+1
  };
  visible=0;
  while lt(visible,count)*(1-lt(take(totals,0,visible),state.threshold)) {
    visible=visible+1
  };
  {indices: indices,totals: totals,count: visible,count_text: to_json(visible)?,capacity: capacity}
}
def u:du_compute_children(state) {
  "Provide du compute children behavior in this MLPL module.";
  if equal(list_len(state.snapshot.paths),0) {
    {indices: fill([0],0),totals: fill([0],0),count: 0,count_text: "0",capacity: 0}
  } else { u:du_children_nonempty(state) }
}
def u:du_children(state) {
  "Provide du children behavior in this MLPL module.";
  state.children
}
def u:du_count(children) {
  "Provide du count behavior in this MLPL module.";
  to_int(children.count_text)?
}
def u:du_total_at(children,index) {
  "Provide du total at behavior in this MLPL module.";
  row=take(reshape(children.totals,[children.capacity,1]),0,index);
  reduce_add(row)
}
def u:du_child_path_at(state,children,index) {
  "Provide du child path at behavior in this MLPL module.";
  u:du_child_path(list_get(state.snapshot.paths,take(children.indices,0,index))?,state.breadcrumb)
}
def u:du_child_is_dir(state,path) {
  "Provide du child is dir behavior in this MLPL module.";
  index=u:du_stable_id(state,path);
  if lt(index,0) {
    0
  } else {
    equal(list_get(state.snapshot.kinds,index)?,"dir")
  }
}
def u:du_activate(state,index) {
  "Provide du activate behavior in this MLPL module.";
  children=u:du_children(state);
  if 1-lt(index,children.count) {
    state
  } else {
    path=u:du_child_path_at(state,children,index);
    if u:du_child_is_dir(state,path) { u:du_restate(state,path,0,state.threshold,state.camera) } else { u:du_restate(state,state.breadcrumb,index,state.threshold,state.camera) }
  }
}
def u:du_parent(state) {
  "Provide du parent behavior in this MLPL module.";
  if equal(state.breadcrumb,"") {
    state
  } else {
    exited=state.breadcrumb;
    parts=str_split(exited,"/");
    count=list_len(parts)-1;
    parent="";
    index=0;
    while lt(index,count) {
      parent=if equal(parent,"") {
        list_get(parts,index)?
      } else {
        str_concat(parent,str_concat("/",list_get(parts,index)?))
      };
      index=index+1
    };
    next=u:du_restate(state,parent,0,state.threshold,state.camera);
    children=u:du_children(next);
    selected=0;
    index=0;
    while lt(index,children.count) {
      if equal(u:du_child_path_at(next,children,index),exited) {
        selected=index
      };
      index=index+1
    };
    u:du_restate(next,parent,selected,state.threshold,state.camera)
  }
}
def u:du_threshold(state,threshold) {
  "Provide du threshold behavior in this MLPL module.";
  u:du_restate(state,state.breadcrumb,0,threshold,state.camera)
}
def u:du_rank_height(index) {
  "Provide du rank height behavior in this MLPL module.";
  10-index*0.3
}
def u:du_bytes(bytes) {
  "Provide du bytes behavior in this MLPL module.";
  if 1-lt(bytes,1073741824) {
    str_concat(to_json(floor(bytes/1073741824))?," GiB")
  } else {
    if 1-lt(bytes,1048576) {
      str_concat(to_json(floor(bytes/1048576))?," MiB")
    } else {
      if 1-lt(bytes,1024) {
        str_concat(to_json(floor(bytes/1024))?," KiB")
      } else {
        str_concat(to_json(bytes)?," B")
      }
    }
  }
}
def u:du_help(state) {
  "Provide du help behavior in this MLPL module.";
  parent_hint=if equal(state.breadcrumb,"") {
    "LEFT/P/BACKSPACE/DELETE=PARENT (AT ROOT)"
  } else {
    "LEFT/P/BACKSPACE/DELETE=PARENT; EXITED DIR STAYS YELLOW"
  };
  str_concat("DISK USAGE — READ-ONLY SNAPSHOT; FILE CONTENTS NEVER READ\nDIRS FIRST, THEN FILES; EACH GROUP LARGEST-FIRST | GREENS=DIR | BLUE/PURPLE/ORANGE=FILE | YELLOW=SELECTED\nUP/DOWN=PREV/NEXT | RIGHT/ENTER=DESCEND KIND DIR; KIND FILE CANNOT DESCEND\nCLICK=SELECT (16 VISIBLE ITEMS MAX) | ",str_concat(parent_hint,"\nT=THRESHOLD 1 MIB/OFF | LEFT DRAG=ORBIT | SHIFT+LEFT/MIDDLE=PAN | WHEEL=ZOOM\nR=RESET VIEW | ESC=CLOSE | NO REFRESH, DELETE, MOVE, RENAME, OR WRITE"))
}
def u:du_status(state) {
  "Provide du status behavior in this MLPL module.";
  detail=if equal(list_len(state.snapshot.paths),0) {
    "SELECTED KIND EMPTY"
  } else {
    children=u:du_children(state);
    path=u:du_child_path_at(state,children,state.selected);
    if u:du_child_is_dir(state,path) {
      str_concat("SELECTED KIND DIR — ENTER DESCENDS | PATH ",path)
    } else {
      str_concat("SELECTED KIND FILE — ENTER DOES NOTHING | PATH ",path)
    }
  };
  text=str_concat(detail,str_concat("\nBREADCRUMB /",state.breadcrumb));
  str_concat(text,str_concat(" | SNAPSHOT EXCLUDED ",str_concat(to_json(state.snapshot.excluded_entries)?,str_concat(" ENTRIES / ",str_concat(to_json(state.snapshot.excluded_bytes)?," KNOWN B")))))
}
