# MLPL application semantics for demos disk usage live applet.
include "./scene.mlpl";

def u:du_submit(state) {
  "Provide du submit behavior in this MLPL module.";
  scene=u:du_scene(state)?;
  port_send(port,{op: "set_scene",positions: scene.positions,edges: scene.edges,colors: scene.colors,thicknesses: scene.thicknesses,ids: scene.ids,rotation_y_speed: 0,revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:du_help(state),status: u:du_status(state)});
  ok(state)
}
def u:du_submit_view(state) {
  "Provide du submit view behavior in this MLPL module.";
  port_send(port,{op: "set_view",revision: state.revision,camera: u:n3d_camera_record(state.camera),help: u:du_help(state),status: u:du_status(state)});
  ok(state)
}
def u:du_submit_patch(before,after) {
  "Provide du submit patch behavior in this MLPL module.";
  port_send(port,u:du_scene_patch(before,after)?);
  u:du_submit_view(after)?;
  ok(after)
}

def u:du_key_event(event,state) {
  "Provide du key event behavior in this MLPL module.";
  children=u:du_children(state);
  selected=state.selected;
  if equal(event.key,"arrow_down")*lt(selected+1,children.count)*lt(selected,15) {
    selected=selected+1
  };
  if equal(event.key,"arrow_up")*gt(selected,0) {
    selected=selected-1
  };
  next=u:du_restate(state,state.breadcrumb,selected,state.threshold,state.camera);
  if equal(event.key,"enter")+equal(event.key,"arrow_right") {
    next=u:du_activate(next,next.selected)
  };
  if equal(event.key,"p")+equal(event.key,"backspace")+equal(event.key,"arrow_left") {
    next=u:du_parent(next)
  };
  if equal(event.key,"t") {
    next=u:du_threshold(next,if eq(next.threshold,0) {
        1048576
      } else {
        0
      })
  };
  if equal(event.key,"r") {
    fresh=u:du_defaults(state.snapshot);
    next=u:du_restate(state,state.breadcrumb,state.selected,state.threshold,fresh.camera)
  };
  u:du_submit_patch(state,next)?;
  next
}
def u:du_pointer_down(event,state) {
  "Provide du pointer down behavior in this MLPL module.";
  camera=u:n3d_camera_reduce(state.camera,event);
  u:du_viewstate(state,camera,event.x,event.y,0)
}
def u:du_pointer_move(event,state) {
  "Provide du pointer move behavior in this MLPL module.";
  distance2=(event.x-state.press_x)*(event.x-state.press_x)+(event.y-state.press_y)*(event.y-state.press_y);
  dragged=if state.dragged+gt(distance2,16) {
    1
  } else {
    0
  };
  camera=if dragged { u:n3d_camera_reduce(state.camera,event) } else {
    state.camera
  };
  next=u:du_viewstate(state,camera,state.press_x,state.press_y,dragged);
  if dragged { u:du_submit_view(next)? };
  next
}
def u:du_pointer_up(event,state) {
  "Provide du pointer up behavior in this MLPL module.";
  camera=u:n3d_camera_reduce(state.camera,event);
  picked=if state.dragged {
    -1
  } else { u:du_pick(state,event)? };
  selected=if lt(picked,0) {
    state.selected
  } else {
    picked
  };
  next=if equal(selected,state.selected) { u:du_viewstate(state,camera,state.press_x,state.press_y,0) } else { u:du_restate(state,state.breadcrumb,selected,state.threshold,camera) };
  if equal(selected,state.selected) { u:du_submit_view(next)? } else { u:du_submit_patch(state,next)? };
  next
}
def u:du_event(event,state) {
  "Provide du event behavior in this MLPL module.";
  if equal(event.kind,"key") { u:du_key_event(event,state) } else {
    if equal(event.kind,"wheel") {
      camera=u:n3d_camera_reduce(state.camera,event);
      next=u:du_viewstate(state,camera,state.press_x,state.press_y,state.dragged);
      u:du_submit_view(next)?;
      next
    } else {
      if equal(event.kind,"pointer_down") { u:du_pointer_down(event,state) } else {
        if equal(event.kind,"pointer_move")*state.camera.dragging { u:du_pointer_move(event,state) } else {
          if equal(event.kind,"pointer_up") { u:du_pointer_up(event,state) } else {
            if equal(event.kind,"resize") { u:du_state(state.snapshot,state.breadcrumb,state.selected,state.threshold,state.camera,state.revision,state.close_requested,event.width,event.height,state.press_x,state.press_y,state.dragged,state.children) } else {
              if equal(event.kind,"close") { u:du_state(state.snapshot,state.breadcrumb,state.selected,state.threshold,state.camera,state.revision,1,state.viewport_width,state.viewport_height,state.press_x,state.press_y,0,state.children) } else {
                state
              }
            }
          }
        }
      }
    }
  }
}

state=u:du_defaults(disk_usage_snapshot);
u:du_submit(state)?;
on(port,"key",:u:du_event);
on(port,"pointer_move",:u:du_event);
on(port,"pointer_down",:u:du_event);
on(port,"pointer_up",:u:du_event);
on(port,"wheel",:u:du_event);
on(port,"resize",:u:du_event);
on(port,"close",:u:du_event);
run(port,state)
