# MLPL application semantics for demos disk usage scene.
include "./model.mlpl";
def u:du_rank_color(is_dir,index) {
  "Provide du rank color behavior in this MLPL module.";
  band=index-floor(index/3)*3;
  if is_dir {
    if equal(band,0) {
      [0.1,0.95,0.55,1]
    } else {
      if equal(band,1) {
        [0.15,0.8,0.3,1]
      } else {
        [0.25,1,0.75,1]
      }
    }
  } else {
    if equal(band,0) {
      [0.25,0.45,1,1]
    } else {
      if equal(band,1) {
        [0.75,0.35,1,1]
      } else {
        [1,0.45,0.2,1]
      }
    }
  }
}
def u:du_add_rank_box(lines,state,children,index,selected) {
  "Provide du add rank box behavior in this MLPL module.";
  height=u:du_rank_height(index);
  column=index-floor(index/4)*4;
  row=floor(index/4);
  path=u:du_child_path_at(state,children,index);
  base=u:du_rank_color(u:du_child_is_dir(state,path),index);
  color=if equal(index,selected) {
    [1,0.9,0.15,1]
  } else {
    base
  };
  thickness=if equal(index,selected) {
    5
  } else {
    2
  };
  u:atlas_add_box(lines,column*3,height/2,row*3,2,height,2,color,thickness,1000+index*12)
}
def u:du_add_visible_boxes(lines,state,selected) {
  "Provide du add visible boxes behavior in this MLPL module.";
  children=u:du_children(state);
  lines=u:du_add_rank_box(lines,state,children,0,selected);
  lines=u:du_add_rank_box(lines,state,children,1,selected);
  lines=u:du_add_rank_box(lines,state,children,2,selected);
  lines=u:du_add_rank_box(lines,state,children,3,selected);
  lines=u:du_add_rank_box(lines,state,children,4,selected);
  lines=u:du_add_rank_box(lines,state,children,5,selected);
  lines=u:du_add_rank_box(lines,state,children,6,selected);
  lines=u:du_add_rank_box(lines,state,children,7,selected);
  lines=u:du_add_rank_box(lines,state,children,8,selected);
  lines=u:du_add_rank_box(lines,state,children,9,selected);
  lines=u:du_add_rank_box(lines,state,children,10,selected);
  lines=u:du_add_rank_box(lines,state,children,11,selected);
  lines=u:du_add_rank_box(lines,state,children,12,selected);
  lines=u:du_add_rank_box(lines,state,children,13,selected);
  lines=u:du_add_rank_box(lines,state,children,14,selected);
  u:du_add_rank_box(lines,state,children,15,selected)
}
def u:du_add_type_marker(lines,state) {
  "Provide du add type marker behavior in this MLPL module.";
  children=u:du_children(state);
  path=u:du_child_path_at(state,children,state.selected);
  column=state.selected-floor(state.selected/4)*4;
  row=floor(state.selected/4);
  height=u:du_rank_height(state.selected);
  if u:du_child_is_dir(state,path) { u:atlas_add(lines,[column*3,height+0.4,row*3],[column*3,height+2.4,row*3],[0.1,1,0.65,1],7,900) } else { u:atlas_add(lines,[column*3-1.2,height+1.4,row*3],[column*3+1.2,height+1.4,row*3],[1,0.4,0.1,1],7,900) }
}
def u:du_scene(state) {
  "Provide du scene behavior in this MLPL module.";
  lines=u:du_add_visible_boxes(u:atlas_lines(),state,state.selected);
  style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids};
  u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0)
}
def u:du_scene_patch(before,after) {
  "Provide du scene patch behavior in this MLPL module.";
  lines=u:atlas_lines();
  topology=(1-equal(before.breadcrumb,after.breadcrumb))+(1-equal(before.threshold,after.threshold));
  if topology {
    lines=u:du_add_visible_boxes(lines,after,after.selected)
  } else {
    if 1-equal(before.selected,after.selected) {
      old_children=u:du_children(before);
      new_children=u:du_children(after);
      lines=u:du_add_rank_box(lines,before,old_children,before.selected,-1);
      lines=u:du_add_rank_box(lines,after,new_children,after.selected,after.selected)
    }
  };
  ok({op: "patch_scene",base_revision: before.revision,target_revision: after.revision,ids: lines.ids,starts: reshape(lines.starts,[lines.count,3]),ends: reshape(lines.ends,[lines.count,3]),colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,remove_ids: fill([0],0)})
}
def u:du_pick(state,event) {
  "Provide du pick behavior in this MLPL module.";
  ray=u:n3d_pick_ray(state.camera,{viewport: {width: state.viewport_width,height: state.viewport_height},xy: [event.x,event.y]})?;
  children=u:du_children(state);
  limit=if lt(children.count,16) {
    children.count
  } else {
    16
  };
  found=-1;
  nearest=1000000000;
  index=0;
  while lt(index,limit) {
    height=u:du_rank_height(index);
    column=index-floor(index/4)*4;
    row=floor(index/4);
    hit=u:atlas_ray_box_distance(ray,[column*3,height/2,row*3],[3,height+1,3]);
    if hit.hit*lt(hit.distance,nearest) {
      found=index;
      nearest=hit.distance
    };
    index=index+1
  };
  ok(found)
}
