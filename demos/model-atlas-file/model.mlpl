# MLPL application semantics for demos model atlas file model.
include "./menu.mlpl";

def u:file_atlas_state(paths,selected,mode,path,catalog,camera,revision,close_requested,tensor_selected,viewport_width,viewport_height,press_x,press_y,gesture_dragged) {
  "Provide file atlas state behavior in this MLPL module.";
  {paths: paths,selected: selected,mode: mode,path: path,catalog: catalog,camera: camera,revision: revision,close_requested: close_requested,tensor_selected: tensor_selected,viewport_width: viewport_width,viewport_height: viewport_height,press_x: press_x,press_y: press_y,gesture_dragged: gesture_dragged}
}
def u:file_atlas_discover(limit) {
  "The host confines the walk; the UI and selectable prefix are capped by limit.";
  fs_walk(".",{recursive: 1,kind: "file",pattern: "*.safetensors"})?
}
def u:file_atlas_defaults(paths) {
  "Provide file atlas defaults behavior in this MLPL module.";
  camera=u:n3d_camera_state([7,2,5],-0.65,0.55,32,1.0471975511965976,0.1,0,"none",0,0);
  u:file_atlas_state(paths,0,"menu","",{tensor_count: 0},camera,0,0,-1,800,600,0,0,0)
}
def u:file_atlas_restate(state,selected,mode,path,catalog,camera,close_requested) {
  "Provide file atlas restate behavior in this MLPL module.";
  u:file_atlas_state(state.paths,selected,mode,path,catalog,camera,state.revision+1,close_requested,state.tensor_selected,state.viewport_width,state.viewport_height,state.press_x,state.press_y,state.gesture_dragged)
}
def u:file_atlas_selected_path(state) {
  "Provide file atlas selected path behavior in this MLPL module.";
  if eq(list_len(state.paths),0) {
    ""
  } else {
    list_get(state.paths,state.selected)?
  }
}
def u:file_atlas_tensor_name(state,wanted) {
  "Provide file atlas tensor name behavior in this MLPL module.";
  keys=state.catalog.header_keys;
  key_index=0;
  tensor_index=0;
  found="";
  while lt(key_index,list_len(keys)) {
    name=list_get(keys,key_index)?;
    if 1-equal(name,"__metadata__") {
      if eq(tensor_index,wanted) {
        found=name
      };
      tensor_index=tensor_index+1
    };
    key_index=key_index+1
  };
  found
}
def u:file_atlas_size_label(size) {
  "Provide file atlas size label behavior in this MLPL module.";
  if gt(size,1073741823) {
    whole=floor(size/1073741824);
    tenth=floor(mod(size,1073741824)*10/1073741824);
    u:atlas_city_text(to_json(whole)?,u:atlas_city_text(".",u:atlas_city_text(to_json(tenth)?," GiB")))
  } else { u:atlas_city_text(to_json(floor(size/1048576))?," MiB") }
}
def u:file_atlas_pad2(value) {
  "Provide file atlas pad2 behavior in this MLPL module.";
  text=to_json(value)?;
  if lt(value,10) { u:atlas_city_text("0",text) } else {
    text
  }
}
def u:file_atlas_utc_date(modified_unix_ms) {
  "Provide file atlas utc date behavior in this MLPL module.";
  days=floor(modified_unix_ms/86400000);
  z=days+719468;
  era=floor(z/146097);
  doe=z-era*146097;
  yoe=floor((doe-floor(doe/1460)+floor(doe/36524)-floor(doe/146096))/365);
  year=yoe+era*400;
  doy=doe-(365*yoe+floor(yoe/4)-floor(yoe/100));
  mp=floor((5*doy+2)/153);
  day=doy-floor((153*mp+2)/5)+1;
  month=mp+if lt(mp,10) {
    3
  } else {
    -9
  };
  year=year+if lt(month,3) {
    1
  } else {
    0
  };
  text=u:atlas_city_text(to_json(year)?,"-");
  text=u:atlas_city_text(text,u:file_atlas_pad2(month));
  text=u:atlas_city_text(text,"-");
  u:atlas_city_text(text,u:file_atlas_pad2(day))
}
def u:file_atlas_status(state) {
  "Provide file atlas status behavior in this MLPL module.";
  if equal(state.mode,"scanning") { u:atlas_city_text("ANALYZING BOUNDED HEADER: ",state.path) } else {
    if equal(state.mode,"atlas") {
      if lt(state.tensor_selected,0) { u:atlas_city_text("FILE: ",state.path) } else {
        row=take(state.catalog.rows_by_name,0,state.tensor_selected);
        start=take(row,0,0);
        ending=take(row,0,1);
        bytes=ending-start;
        params=take(row,0,2);
        width=take(row,0,3);
        name=u:file_atlas_tensor_name(state,state.tensor_selected);
        info=record_get(state.catalog.header,name)?;
        dtype=record_get(info,"dtype")?;
        shape=record_get(info,"shape")?;
        percent=if eq(state.catalog.tensor_bytes,0) {
          0
        } else {
          floor(bytes*1000/state.catalog.tensor_bytes)/10
        };
        text=u:atlas_city_text("SELECTED TENSOR: ",name);
        text=u:atlas_city_text(text,u:atlas_city_text("\nDTYPE ",u:atlas_city_text(dtype,u:atlas_city_text(" | SHAPE ",to_json(shape)?))));
        text=u:atlas_city_text(text,u:atlas_city_text(" | PARAMS ",to_json(params)?));
        text=u:atlas_city_text(text,u:atlas_city_text("\nSTORED ",u:atlas_city_text(to_json(bytes)?," B")));
        text=u:atlas_city_text(text,u:atlas_city_text(" | MODEL STORAGE ",u:atlas_city_text(to_json(percent)?,"%")));
        u:atlas_city_text(text,u:atlas_city_text(" | OFFSETS ",u:atlas_city_text(to_json(start)?,u:atlas_city_text("..",to_json(ending)?))))
      }
    } else {
      if eq(list_len(state.paths),0) {
        "NO MODEL SELECTED"
      } else {
        path=u:file_atlas_selected_path(state);
        metadata=file_metadata(path)?;
        ordinal=to_json(state.selected+1)?;
        count=if lt(list_len(state.paths),12) {
          list_len(state.paths)
        } else {
          12
        };
        text=u:atlas_city_text(">> SELECTED [",u:atlas_city_text(ordinal,u:atlas_city_text("/",u:atlas_city_text(to_json(count)?,"]  "))));
        text=u:atlas_city_text(text,u:file_atlas_size_label(metadata.size));
        text=u:atlas_city_text(text,u:atlas_city_text(" | MODIFIED ",u:atlas_city_text(u:file_atlas_utc_date(metadata.modified_unix_ms)," UTC")));
        u:atlas_city_text(text,u:atlas_city_text("\n",path))
      }
    }
  }
}
def u:file_atlas_menu_help(state) {
  "Provide file atlas menu help behavior in this MLPL module.";
  text="MODEL ATLAS — REAL LOCAL SAFETENSORS\nUP/DOWN=CHOOSE | ENTER=BOUNDED ANALYZE | ESC=CLOSE\nYELLOW PANEL IS THE ACTIVE ROW; DATES ARE LAST-MODIFIED UTC\n";
  count=if lt(list_len(state.paths),12) {
    list_len(state.paths)
  } else {
    12
  };
  if eq(count,0) { u:atlas_city_text(text,"NO .SAFETENSORS FILES FOUND") } else {
    index=0;
    while lt(index,count) {
      path=list_get(state.paths,index)?;
      metadata=file_metadata(path)?;
      summary=u:atlas_city_text(u:file_atlas_size_label(metadata.size),u:atlas_city_text(" | ",u:atlas_city_text(u:file_atlas_utc_date(metadata.modified_unix_ms)," UTC")));
      row=u:atlas_city_text("[",u:atlas_city_text(to_json(index+1)?,u:atlas_city_text("] ",u:atlas_city_text(summary,u:atlas_city_text("  ",path)))));
      text=u:atlas_city_text(text,row);
      text=u:atlas_city_text(text,"\n");
      index=index+1
    };
    text
  }
}
def u:file_atlas_analyze(state) {
  "Provide file atlas analyze behavior in this MLPL module.";
  path=list_get(state.paths,state.selected)?;
  catalog=u:catalog_safetensors(path,1048576,200000,9007199254740991)?;
  raw=u:read_safetensors_header(path,1048576)?;
  header=parse_json(decode_bytes(raw.header_bytes),{max_depth: 8,max_bytes: 1048576,max_elements: 200000})?;
  catalog={header_keys: catalog.header_keys,tensor_count: catalog.tensor_count,parameter_count: catalog.parameter_count,tensor_bytes: catalog.tensor_bytes,data_bytes: catalog.data_bytes,metadata_present: catalog.metadata_present,rows_by_name: catalog.rows_by_name,header: header};
  next=u:file_atlas_restate(state,state.selected,"atlas",path,catalog,state.camera,0);
  u:file_atlas_state(next.paths,next.selected,next.mode,next.path,next.catalog,next.camera,next.revision,next.close_requested,-1,next.viewport_width,next.viewport_height,0,0,0)
}
def u:file_atlas_key(state,key) {
  "Provide file atlas key behavior in this MLPL module.";
  if equal(state.mode,"menu") {
    available=if lt(list_len(state.paths),12) {
      list_len(state.paths)
    } else {
      12
    };
    selected=state.selected;
    if equal(key,"arrow_down")*lt(selected+1,available) {
      selected=selected+1
    };
    if equal(key,"arrow_up")*gt(selected,0) {
      selected=selected-1
    };
    if equal(key,"enter")*gt(available,0) { u:file_atlas_restate(state,selected,"scanning",list_get(state.paths,selected)?,state.catalog,state.camera,0) } else { u:file_atlas_restate(state,selected,"menu","",state.catalog,state.camera,0) }
  } else {
    if equal(key,"m") { u:file_atlas_restate(state,state.selected,"menu","",state.catalog,state.camera,0) } else {
      if equal(key,"r") {
        fresh=u:file_atlas_defaults(state.paths);
        u:file_atlas_restate(state,state.selected,state.mode,state.path,state.catalog,fresh.camera,0)
      } else {
        state
      }
    }
  }
}
def u:file_atlas_with_interaction(state,camera,tensor_selected,press_x,press_y,dragged) {
  "Provide file atlas with interaction behavior in this MLPL module.";
  u:file_atlas_state(state.paths,state.selected,state.mode,state.path,state.catalog,camera,state.revision+1,state.close_requested,tensor_selected,state.viewport_width,state.viewport_height,press_x,press_y,dragged)
}
def u:file_atlas_height(bytes) {
  "Provide file atlas height behavior in this MLPL module.";
  if lt(bytes,1) {
    0.25
  } else {
    1+log(bytes)/log(2)/4
  }
}
def u:file_atlas_pick(state,event) {
  "Provide file atlas pick behavior in this MLPL module.";
  ray=u:n3d_pick_ray(state.camera,{viewport:{width: state.viewport_width,height: state.viewport_height},xy:[event.x,event.y]})?;
  limit=if lt(state.catalog.tensor_count,32) {
    state.catalog.tensor_count
  } else {
    32
  };
  found=-1;
  nearest=1000000000;
  index=0;
  while lt(index,limit) {
    row=take(state.catalog.rows_by_name,0,index);
    bytes=take(row,0,1)-take(row,0,0);
    height=u:file_atlas_height(bytes);
    column=index-floor(index/8)*8;
    row_index=floor(index/8);
    hit=u:atlas_ray_box_distance(ray,[column*2,height/2,row_index*3],[1.8,height+0.5,1.8]);
    if hit.hit*lt(hit.distance,nearest) {
      found=index;
      nearest=hit.distance
    };
    index=index+1
  };
  ok(found)
}
def u:file_atlas_pointer_event(state,event) {
  "Provide file atlas pointer event behavior in this MLPL module.";
  if equal(event.kind,"pointer_down") {
    camera=u:n3d_camera_reduce(state.camera,event);
    u:file_atlas_with_interaction(state,camera,state.tensor_selected,event.x,event.y,0)
  } else {
    if equal(event.kind,"pointer_move")*state.camera.dragging {
      distance2=(event.x-state.press_x)*(event.x-state.press_x)+(event.y-state.press_y)*(event.y-state.press_y);
      dragged=if state.gesture_dragged+gt(distance2,16) {
        1
      } else {
        0
      };
      camera=if dragged { u:n3d_camera_reduce(state.camera,event) } else {
        state.camera
      };
      u:file_atlas_with_interaction(state,camera,state.tensor_selected,state.press_x,state.press_y,dragged)
    } else {
      if equal(event.kind,"pointer_up") {
        camera=u:n3d_camera_reduce(state.camera,event);
        selected=if equal(event.button,"left")*(1-state.gesture_dragged) { u:file_atlas_pick(state,event)? } else {
          state.tensor_selected
        };
        u:file_atlas_with_interaction(state,camera,selected,state.press_x,state.press_y,0)
      } else {
        if equal(event.kind,"wheel") {
          camera=u:n3d_camera_reduce(state.camera,event);
          u:file_atlas_with_interaction(state,camera,state.tensor_selected,state.press_x,state.press_y,state.gesture_dragged)
        } else {
          state
        }
      }
    }
  }
}
