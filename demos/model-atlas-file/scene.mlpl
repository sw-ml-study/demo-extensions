# MLPL application semantics for demos model atlas file scene.
include "./model.mlpl";

def u:file_atlas_empty_scene() {
  "Provide file atlas empty scene behavior in this MLPL module.";
  u:n3d_plane_grid(1,1,4,[0.15,0.3,0.45,1],1)
}
def u:file_atlas_add_scale(lines) {
  "Provide file atlas add scale behavior in this MLPL module.";
  white=[0.9,0.9,0.9,1];
  green=[0.65,1,0.55,1];
  blue=[0.2,0.65,1,1];
  yellow=[1,0.9,0.15,1];
  lines=u:atlas_add(lines,[-2,1,0],[-2,8.5,0],white,2,200);
  levels=[1,3.5,6,8.5];
  index=0;
  while lt(index,4) {
    y=take(levels,0,index);
    lines=u:atlas_add(lines,[-2.35,y,0],[-1.65,y,0],white,2,201+index);
    index=index+1
  };
  lines=u:atlas_add_digit(lines,0,-2.75,1,210);
  lines=u:atlas_add_digit(lines,1,-3,3.5,220);
  lines=u:atlas_add_digit(lines,0,-2.5,3.5,230);
  lines=u:atlas_add_digit(lines,2,-3,6,240);
  lines=u:atlas_add_digit(lines,0,-2.5,6,250);
  lines=u:atlas_add_digit(lines,3,-3,8.5,260);
  lines=u:atlas_add_digit(lines,0,-2.5,8.5,270);
  lines=u:atlas_add_b(lines,-2,9.05,green,280);
  lines=u:atlas_add(lines,[-5.5,8.5,0],[-4.6,8.5,0],blue,6,290);
  lines=u:atlas_add_t(lines,-4.3,8.5,blue,291);
  lines=u:atlas_add(lines,[-5.5,7.9,0],[-4.6,7.9,0],yellow,6,300);
  lines=u:atlas_add_s(lines,-4.3,7.9,yellow,301);
  lines=u:atlas_add_e(lines,-3.85,7.9,yellow,306);
  u:atlas_add_l(lines,-3.4,7.9,yellow,310)
}
def u:file_atlas_scene(state) {
  "Provide file atlas scene behavior in this MLPL module.";
  lines=u:file_atlas_add_scale(u:atlas_lines());
  keys=state.catalog.header_keys;
  tensor_index=0;
  key_index=0;
  limit=if lt(state.catalog.tensor_count,32) {
    state.catalog.tensor_count
  } else {
    32
  };
  while lt(key_index,list_len(keys))*lt(tensor_index,limit) {
    name=list_get(keys,key_index)?;
    if 1-equal(name,"__metadata__") {
      row=take(state.catalog.rows_by_name,0,tensor_index);
      column=tensor_index-floor(tensor_index/8)*8;
      row_index=floor(tensor_index/8);
      bytes=take(row,0,1)-take(row,0,0);
      height=u:file_atlas_height(bytes);
      selected=eq(tensor_index,state.tensor_selected);
      color=if selected {
        [1,0.9,0.15,1]
      } else {
        [0.2,0.65,1,1]
      };
      thickness=if selected {
        4
      } else {
        2
      };
      lines=u:atlas_add_box(lines,column*2,height/2,row_index*3,1,height,1,color,thickness,1000+tensor_index*12);
      tensor_index=tensor_index+1
    };
    key_index=key_index+1
  };
  style={colors: reshape(lines.colors,[lines.count,4]),thicknesses: lines.thicknesses,ids: lines.ids};
  u:n3d_lines(reshape(lines.positions,[lines.count*2,3]),reshape(lines.edges,[lines.count,2]),style,0)
}
def u:file_atlas_atlas_help(state) {
  "Provide file atlas atlas help behavior in this MLPL module.";
  count=to_json(state.catalog.tensor_count)?;
  shown=if lt(state.catalog.tensor_count,32) {
    count
  } else {
    "32"
  };
  text=u:atlas_city_text("MODEL ATLAS — ONE WIREFRAME BAR PER TENSOR (FIRST 32)\nFILE: ",state.path);
  text=u:atlas_city_text(text,u:atlas_city_text("\nCATALOG TENSORS: ",count));
  text=u:atlas_city_text(text,u:atlas_city_text(" | SHOWN: ",shown));
  text=u:atlas_city_text(text," | HEADER ONLY; NO PAYLOAD READ\nHEIGHT=1+LOG2(STORED BYTES)/4 | WORLD AXIS=LOG2 BYTES: 0,10,20,30 | B=BYTE UNIT\nWORLD LEGEND: BLUE T=TENSOR | YELLOW SEL=CLICK-SELECTED TENSOR\nCLICK NEAR BAR=SELECT | LEFT DRAG=ORBIT/TILT | SHIFT+LEFT/MIDDLE=PAN | WHEEL=ZOOM\nR=RESET VIEW | M=MODEL MENU | ESC=CLOSE");
  text
}
