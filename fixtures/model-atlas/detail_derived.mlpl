# Small deterministic detail IR derived from demo-ml-utils visualization contracts.

def u:atlas_detail_budgets() { {max_bins: 4,max_surface_points: 4,max_error_points: 4,max_abs_value: 128,max_output_objects: 16} }
def u:atlas_detail_tile(parent_id,format,minimum,maximum,counts,samples) { {parent_id: parent_id,format: format,lod: 2,value_count: reduce(:add,counts),minimum: minimum,maximum: maximum,mean: reduce(:add,samples)/tally(samples),rms: sqrt(reduce(:add,samples*samples)/tally(samples)),bin_edges: minimum+range(tally(counts)+1)*(maximum-minimum)/tally(counts),bin_counts: counts,sample_indices: range(tally(samples)),sample_values: samples} }
def u:atlas_detail_fixture(index) { if eq(index,0) { tile=u:atlas_detail_tile("safe-city:tensor:model.embed_tokens.weight","safetensors",-2,3,[1,2,1,1],[-2,-1,1,3]); ok({schema: "sw-ml-study.distribution-surfaces",version: 1,provenance: {analyzer: "derived-fixture-compatible-with-demo-ml-utils",artifact: "derived/valid-catalog.safetensors",tensor: "model.embed_tokens.weight",payload: "bounded synthetic values; not user model payload"},tile: tile,quantization: {available: 0,reason: "Safetensors fixture has no quantized reconstruction reference"}}) } else { if eq(index,3) { tile=u:atlas_detail_tile("gguf-city:tensor:model.layers.0.ssm.in_proj.weight","gguf",-8,8,[2,3,2,1],[-8,-2,2,8]); ok({schema: "sw-ml-study.distribution-surfaces",version: 1,provenance: {analyzer: "derived-fixture-compatible-with-demo-ml-utils",artifact: "derived/valid-catalog.gguf",tensor: "model.layers.0.ssm.in_proj.weight",payload: "bounded synthetic Q8_0 fixture; not user model payload"},tile: tile,quantization: {available: 1,schema: "sw-ml-study.q8-error-tile",rmse: 0.125,max_error: 0.25,cosine: 0.999,errors: [0.25,-0.125,0,0.125]}}) } else { err("PAYLOAD DETAIL UNSUPPORTED: no bounded decoded fixture for this tensor; catalog metadata remains available") } } }
def u:atlas_detail_validate(detail,b) { tile=detail.tile; bins=tally(tile.bin_counts); points=tally(tile.sample_values); errors=if detail.quantization.available { tally(detail.quantization.errors) } else { 0 }; if (1-equal(detail.schema,"sw-ml-study.distribution-surfaces"))+(1-eq(detail.version,1))+gt(bins,b.max_bins)+gt(points,b.max_surface_points)+gt(errors,b.max_error_points)+gt(abs(tile.minimum),b.max_abs_value)+gt(abs(tile.maximum),b.max_abs_value)+gt(bins+points+errors,b.max_output_objects) { err("derived detail IR exceeds schema or visualization budgets") } else { ok(1) } }
def u:atlas_detail_checked(index) { detail=u:atlas_detail_fixture(index)?; u:atlas_detail_validate(detail,u:atlas_detail_budgets())?; ok(detail) }
