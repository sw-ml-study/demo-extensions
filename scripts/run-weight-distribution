#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
default_root=$(CDPATH= cd -- "$repo_root/../demo-ml-utils/models" && pwd)
model_root=${MODEL_ROOT:-$default_root}

case "$model_root" in
    /*) ;;
    *)
        echo "MODEL_ROOT must be an absolute directory path" >&2
        exit 2
        ;;
esac

cd "$repo_root"
cargo run --release -p mlpl-native3d-window -- --weight-distribution "$model_root"
