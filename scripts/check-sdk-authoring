#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for source_file in \
  "$repo_root/extensions/hello/src/lib.rs" \
  "$repo_root/extensions/http-client/src/lib.rs" \
  "$repo_root/extensions/http-client/src/client.rs" \
  "$repo_root/extensions/http-client/src/middleware.rs" \
  "$repo_root/extensions/http-client/src/fields.rs" \
  "$repo_root/extensions/http-client/src/download_plan.rs" \
  "$repo_root/extensions/http-client/src/download.rs" \
  "$repo_root/extensions/http-server/src/lib.rs" \
  "$repo_root/extensions/http-server/src/server.rs" \
  "$repo_root/extensions/digest/src/lib.rs" \
  "$repo_root/extensions/digest/src/sha256.rs" \
  "$repo_root/extensions/hftok/src/lib.rs" \
  "$repo_root/extensions/hftok/src/tokenizer_file.rs" \
  "$repo_root/extensions/hftok/src/file_source.rs" \
  "$repo_root/extensions/hftok/src/byte_level.rs" \
  "$repo_root/extensions/hftok/src/handles.rs"
do
  if rg -n '\bunsafe\b|mlpl_extension_abi' "$source_file"; then
    echo "extension bypasses the safe SDK authoring surface: $source_file" >&2
    exit 1
  fi
done

rg -q 'mlpl_extension_sdk::export_extension!' "$repo_root/extensions/hello/src/lib.rs"
rg -q 'mlpl_extension_sdk::export_extension!' "$repo_root/extensions/http-client/src/lib.rs"
rg -q 'mlpl_extension_sdk::export_extension!' "$repo_root/extensions/digest/src/lib.rs"
rg -q 'mlpl_extension_sdk::export_extension!' "$repo_root/extensions/hftok/src/lib.rs"
rg -q 'mlpl_extension_sdk::export_extension!' "$repo_root/extensions/http-server/src/lib.rs"
echo "PASS safe SDK authoring policy"
