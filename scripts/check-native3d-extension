#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cargo build --offline --quiet --manifest-path "$repo_root/Cargo.toml" -p mlpl-extension-native3d
mlpl=$($repo_root/scripts/select-mlpl)
suffix=so
if [ "$(uname -s)" = Darwin ]; then suffix=dylib; fi
library=$repo_root/target/debug/libmlpl_extension_native3d.$suffix

output=$("$mlpl" --source-dir "$repo_root" -f "$repo_root/demos/native3d-extension/check.mlpl" -- "$library")
printf '%s\n' "$output" | rg -q 'hit: 1'
printf '%s\n' "$output" | rg -q 'id: 10'
if "$mlpl" --source-dir "$repo_root" -e '_native3d:create_viewer(64,64)' >/dev/null 2>&1; then
  echo "native3d call unexpectedly succeeded without loading its extension" >&2
  exit 1
fi
echo "PASS dynamic native3d bulk boxes, view, pick, lifecycle, and extension-free failure"
