#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

check_asset() {
    asset=$1
    maximum=$2
    path="$repo_root/captures/$asset"
    test -f "$path" || {
        echo "missing capture asset: captures/$asset" >&2
        exit 1
    }
    size=$(wc -c <"$path")
    test "$size" -le "$maximum" || {
        echo "capture exceeds byte limit: captures/$asset ($size > $maximum)" >&2
        exit 1
    }
    test "$(dd if="$path" bs=1 skip=8 count=4 2>/dev/null)" = "WEBP" || {
        echo "capture is not WebP: captures/$asset" >&2
        exit 1
    }
}

check_asset life-torus.webp 65536
check_asset life-torus-animated.webp 65536
check_asset audio-spectrum.webp 65536
check_asset audio-spectrum-animated.webp 196608

grep -q 'captures/life-torus-animated.webp' "$repo_root/README.md"
grep -q 'captures/audio-spectrum-animated.webp' "$repo_root/README.md"
grep -q 'audio-spectrum' "$repo_root/docs/demo-captures.md"
test -x "$repo_root/scripts/capture-native-demo"

echo "PASS compact tracked demo captures"
