#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for asset in life-torus.webp life-torus-animated.webp; do
    path="$repo_root/captures/$asset"
    test -f "$path" || {
        echo "missing capture asset: captures/$asset" >&2
        exit 1
    }
    size=$(wc -c <"$path")
    test "$size" -le 65536 || {
        echo "capture exceeds 64 KiB: captures/$asset ($size bytes)" >&2
        exit 1
    }
    test "$(dd if="$path" bs=1 skip=8 count=4 2>/dev/null)" = "WEBP" || {
        echo "capture is not WebP: captures/$asset" >&2
        exit 1
    }
done

grep -q 'captures/life-torus-animated.webp' "$repo_root/README.md"
grep -q 'audio-spectrum' "$repo_root/docs/demo-captures.md"
test -x "$repo_root/scripts/capture-native-demo"

echo "PASS compact tracked demo captures"
