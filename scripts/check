#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

sh -n "$repo_root"/scripts/* "$repo_root/tests/test-layout"
"$repo_root/tests/test-layout"
"$repo_root/scripts/check-gitignore"
"$repo_root/scripts/check-namespaces"
"$repo_root/scripts/check-sdk-authoring"
"$repo_root/scripts/check-tracked"
"$repo_root/scripts/check-mlpl-style"
cargo fmt --manifest-path "$repo_root/Cargo.toml" --check \
    --package mlpl-extension-abi \
    --package mlpl-extension-loader \
    --package mlpl-extension-sdk \
    --package mlpl-extension-hello \
    --package mlpl-native3d-scene \
    --package mlpl-native3d-window \
    --package mlpl-microscope-model \
    --package mlpl-microscope-web \
    --package mlpl-extension-boundary-probe \
    --package mlpl-extension-native3d
"$repo_root/scripts/run-rust-tests" --no-run
cargo clippy --manifest-path "$repo_root/Cargo.toml" --workspace --all-targets -- -D warnings
"$repo_root/scripts/run-rust-tests"
"$repo_root/scripts/check-upstream-provider"
"$repo_root/scripts/run-tests" --format tap >/dev/null
git -C "$repo_root" diff --check

echo "PASS pre-commit"
