#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
layout=$repo_root/fixtures/sw-mlpl-storage-layout-baf015ff.json
expected=be71a69ec5e4e77a41e0c3d45a1bbf08dc288a2161ca10e5970d227dcdf4e87f
actual=$(shasum -a 256 "$layout" | awk '{print $1}')
if [ "$actual" != "$expected" ]; then
  echo "sw-MLPL sample checksum mismatch: expected $expected, got $actual" >&2
  exit 1
fi

mlpl=$($repo_root/scripts/select-mlpl)
preview_dir=$(mktemp -d "${TMPDIR:-/tmp}/mlpl-layout-preview.XXXXXX")
trap 'rm -rf "$preview_dir"' EXIT HUP INT TERM
raw=$preview_dir/output.txt
scene=$preview_dir/box-scene.json
presentation=$preview_dir/box-presentation.json
"$mlpl" --source-dir "$repo_root" -f "$repo_root/demos/system-layout-preview/scene.mlpl" -- "$layout" >"$raw"
sed -n '1p' "$raw" >"$scene"
sed -n '2p' "$raw" >"$presentation"
cargo run --release --manifest-path "$repo_root/Cargo.toml" -p mlpl-native3d-window -- \
  --box-scene "$scene" --box-presentation "$presentation" --selected-box 8
